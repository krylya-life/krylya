---
import { business } from "../config/business.ts";

const counterId = business.metrikaCounterId;

// Счётчик рендерим только в продакшен-сборке: dev-сервер (localhost)
// не должен засорять статистику Метрики.
const isProd = import.meta.env.PROD;
---

{counterId && isProd && (
  <>
    <script is:inline define:vars={{ counterId }}>
      // Отложенная загрузка Метрики через requestIdleCallback —
      // не блокирует LCP, не ухудшает Lighthouse.
      function loadMetrika() {
        // Только боевые домены: тех-копии (pages.dev, netlify.app и т.п.)
        // не должны отправлять визиты в Метрику.
        var allowedHosts = ["xn--j1aco8bgs.life", "крылья.life"];
        var host = location.hostname.replace(/^www\./, "");
        if (allowedHosts.indexOf(host) === -1) return;

        (function (m, e, t, r, i, k, a) {
          m[i] =
            m[i] ||
            function () {
              (m[i].a = m[i].a || []).push(arguments);
            };
          m[i].l = 1 * new Date();
          for (var j = 0; j < document.scripts.length; j++) {
            if (document.scripts[j].src === r) return;
          }
          (k = e.createElement(t)),
            (a = e.getElementsByTagName(t)[0]),
            (k.async = 1),
            (k.src = r),
            a.parentNode.insertBefore(k, a);
        })(window, document, "script", "https://mc.yandex.ru/metrika/tag.js", "ym");

        // @ts-ignore
        window.ym(counterId, "init", {
          clickmap: true,
          trackLinks: true,
          accurateTrackBounce: true,
          webvisor: true,
        });
      }

      if ("requestIdleCallback" in window) {
        // 2 сек после idle — Метрика гарантированно не блокирует LCP
        window.requestIdleCallback(loadMetrika, { timeout: 2000 });
      } else {
        setTimeout(loadMetrika, 1500);
      }
    </script>
    <noscript>
      <div>
        <img
          src={`https://mc.yandex.ru/watch/${counterId}`}
          style="position:absolute; left:-9999px;"
          alt=""
        />
      </div>
    </noscript>
  </>
)}
