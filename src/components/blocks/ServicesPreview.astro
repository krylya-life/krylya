---
/*
 * ServicesPreview — три карточки услуг с верхушки коллекции `services`.
 * Тёмная версия (Wave 3): MagicCard с курсорной подсветкой, ссылка на /services/{slug}/.
 * Шапка секции с кнопкой «Все направления» на /services/.
 */
import MagicCard from "../dark/MagicCard.astro";
import { getCollection } from "astro:content";

const all = await getCollection("services");
const services = all
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 3);
---

<section id="services" class="relative px-6 py-14 md:px-12 md:py-20">
  <div class="mx-auto max-w-6xl">
    <div class="mb-10 flex flex-wrap items-end justify-between gap-6">
      <div class="max-w-2xl">
        <h2 class="text-3xl font-semibold leading-tight tracking-tight text-white md:text-5xl">
          Чем занимаемся
        </h2>
        <span class="mt-4 inline-block h-1 w-12 bg-[#FFF200]"></span>
        <p class="mt-6 max-w-2xl text-white/65 md:text-lg leading-relaxed">
          Полный цикл организации мероприятия — от&nbsp;первого брифа до&nbsp;отчёта после&nbsp;события.
        </p>
      </div>
      <a
        href="/services/"
        class="inline-flex items-center gap-2 rounded-full border border-white/15 bg-white/[0.03] px-5 py-2.5 text-sm font-medium text-white/85 no-underline transition hover:border-white/30 hover:text-white"
      >
        Все направления
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M13 5l7 7-7 7"/></svg>
      </a>
    </div>

    {services.length > 0 ? (
      <div class="grid gap-5 md:grid-cols-3">
        {services.map((s) => (
          <MagicCard
            href={`/services/${s.data.slug}/`}
            class="group flex min-h-[200px] flex-col justify-between p-6"
          >
            <div>
              <h3 class="text-xl font-semibold text-white">{s.data.title}</h3>
              <p class="mt-3 text-sm leading-relaxed text-white/60">{s.data.description}</p>
            </div>
            <span class="mt-6 inline-flex items-center gap-2 text-sm font-medium text-[#FFF200]">
              Подробнее
              <span class="inline-block h-px w-6 bg-[#FFF200] transition-all group-hover:w-10"></span>
            </span>
          </MagicCard>
        ))}
      </div>
    ) : (
      <p class="mt-12 text-white/60 italic">Услуги появятся в Phase 4.</p>
    )}
  </div>
</section>
