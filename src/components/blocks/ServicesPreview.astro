---
import Container from "../Container.astro";
import Section from "../Section.astro";
import Heading from "../Heading.astro";
import Button from "../Button.astro";
import { getCollection } from "astro:content";

const all = await getCollection("services");
const services = all
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 3);
---

<Section>
  <Container>
    <div class="md:flex md:items-end md:justify-between gap-8">
      <div>
        <Heading level={2} accent>Чем занимаемся</Heading>
        <p class="mt-6 max-w-2xl text-lg text-gray-dark leading-relaxed">
          Полный цикл организации мероприятия — от&nbsp;первого брифа
          до&nbsp;отчёта после события.
        </p>
      </div>
      <Button href="/services/" variant="secondary" class="mt-6 md:mt-0 self-start md:self-auto whitespace-nowrap">
        Все направления
      </Button>
    </div>

    {services.length > 0 ? (
      <div class="mt-12 grid gap-6 md:grid-cols-3">
        {services.map((service) => (
          <a
            href={`/services/${service.data.slug}/`}
            class="group block bg-white border border-gray-light p-8 hover:border-yellow hover:shadow-lg transition-all"
          >
            <h3 class="text-xl font-semibold text-black group-hover:text-black">
              {service.data.title}
            </h3>
            <p class="mt-3 text-gray-dark leading-relaxed">
              {service.data.description}
            </p>
            <span class="mt-6 inline-flex items-center gap-2 text-sm font-medium text-black">
              Подробнее
              <span class="inline-block h-0.5 w-6 bg-yellow group-hover:w-10 transition-all"></span>
            </span>
          </a>
        ))}
      </div>
    ) : (
      <p class="mt-12 text-gray-dark italic">Услуги появятся в Phase 4.</p>
    )}
  </Container>
</Section>
