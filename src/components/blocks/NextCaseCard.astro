---
/*
 * NextCaseCard — компактная ссылка «следующий кейс» в подвале страницы кейса.
 * Маленькая миниатюра + заголовок + стрелка. Спокойная, ненавязчивая.
 */
import Picture from "../Picture.astro";

interface NextCase {
  title: string;
  client: string;
  slug: string;
  cover: string;
}

interface Props {
  next: NextCase | null;
}

const { next } = Astro.props;
---

{next && (
  <section class="relative px-6 py-10 md:px-12 md:py-12">
    <div class="mx-auto max-w-6xl">
      <a
        href={`/cases/${next.slug}/`}
        class="lab-cursor-wings group flex items-center gap-4 rounded-xl border border-white/10 bg-white/[0.03] p-3 no-underline transition hover:border-white/25 hover:bg-white/[0.06] sm:gap-5 sm:p-4"
      >
        <div class="relative h-20 w-28 shrink-0 overflow-hidden rounded-lg sm:h-24 sm:w-36">
          <Picture
            src={`/assets/cases/${next.slug}/${next.cover}`}
            alt={`Обложка: ${next.title}`}
            class="absolute inset-0 h-full w-full object-cover transition-transform duration-500 ease-out group-hover:scale-105"
            sizes="144px"
            loading="lazy"
          />
        </div>
        <div class="min-w-0 flex-1">
          <p class="text-[11px] font-semibold uppercase tracking-[0.2em] text-white/45">
            Следующий кейс
          </p>
          <h3 class="mt-1 truncate text-base font-semibold tracking-tight text-white sm:text-lg">
            {next.title}
          </h3>
          <p class="mt-0.5 truncate text-sm text-white/55">{next.client}</p>
        </div>
        <span class="shrink-0 pr-1 text-white/45 transition-transform group-hover:translate-x-1">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12h14M13 5l7 7-7 7"/></svg>
        </span>
      </a>
    </div>
  </section>
)}
