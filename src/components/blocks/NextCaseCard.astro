---
/*
 * NextCaseCard — карточка «следующий кейс» в подвале страницы кейса.
 * Широкий баннер 16:7 с обложкой, клиент-лейблом, заголовком и стрелкой.
 * Тёмная палитра, lab-cursor-wings — курсор «крылья» при наведении.
 */
interface NextCase {
  title: string;
  client: string;
  slug: string;
  cover: string;
}

interface Props {
  next: NextCase | null;
}

const { next } = Astro.props;
---

{next && (
  <section class="lab-bg-alt relative px-6 py-14 md:px-12 md:py-20">
    <div class="mx-auto max-w-6xl">
      <p class="mb-6 text-xs font-semibold uppercase tracking-[0.25em] text-white/55">
        Следующий кейс
      </p>
      <a
        href={`/cases/${next.slug}/`}
        class="lab-cursor-wings group relative block aspect-[16/9] overflow-hidden rounded-2xl no-underline sm:aspect-[16/7]"
      >
        <img
          src={`/assets/cases/${next.slug}/${next.cover}`}
          alt={`Обложка: ${next.title}`}
          class="absolute inset-0 h-full w-full object-cover transition-transform duration-700 ease-out group-hover:scale-105"
          loading="lazy"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-black/85 via-black/35 to-transparent"></div>
        <div class="absolute inset-x-0 bottom-0 p-6 md:p-12">
          <p class="mb-2 text-xs font-semibold uppercase tracking-[0.25em] text-[#FFF200]">
            {next.client}
          </p>
          <h3 class="text-2xl font-semibold leading-tight tracking-tight text-white md:text-4xl">
            {next.title}
          </h3>
          <span class="mt-4 inline-flex items-center gap-2 text-sm font-medium text-white md:mt-6">
            Смотреть кейс
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12h14M13 5l7 7-7 7"/></svg>
          </span>
        </div>
      </a>
    </div>
  </section>
)}
