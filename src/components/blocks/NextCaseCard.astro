---
import Container from "../Container.astro";
import Section from "../Section.astro";

interface NextCase {
  title: string;
  slug: string;
  client: string;
  cover: string;
}

interface Props {
  next: NextCase;
}

const { next } = Astro.props;
---

<Section class="bg-gray-light/15">
  <Container>
    <p class="mb-6 text-sm font-semibold uppercase tracking-wider text-gray-dark">
      Следующий кейс
    </p>
    <a
      href={`/cases/${next.slug}/`}
      class="group block relative overflow-hidden bg-black"
    >
      <div class="aspect-[16/7] md:aspect-[16/5]">
        <img
          src={next.cover}
          alt={`Обложка: ${next.title}`}
          class="w-full h-full object-cover opacity-80 group-hover:opacity-100 transition-opacity"
          loading="lazy"
        />
      </div>
      <div class="absolute inset-0 bg-gradient-to-r from-black/70 to-black/20"></div>
      <div class="absolute inset-0 p-8 md:p-12 flex flex-col justify-center">
        <p class="text-xs md:text-sm font-semibold uppercase tracking-wider text-yellow">
          {next.client}
        </p>
        <h3 class="mt-3 text-2xl md:text-4xl font-semibold text-white max-w-2xl">
          {next.title}
        </h3>
        <span class="mt-6 inline-flex items-center gap-3 text-sm font-medium text-white">
          Читать кейс
          <span class="inline-block h-0.5 w-8 bg-yellow group-hover:w-12 transition-all"></span>
        </span>
      </div>
    </a>
  </Container>
</Section>
