---
/*
 * Audience — карточки трёх сегментов аудитории.
 * Тёмная версия (Wave 3): MagicCard с курсорной подсветкой,
 * жёлтое подчёркивание под заголовком, верхнее свечение секции (lab-glow-top).
 */
import MagicCard from "../dark/MagicCard.astro";

const audiences = [
  {
    title: "Бизнесу с публичным лицом",
    description:
      "Презентации объектов и продуктов, открытия, вечера для клиентов и партнёров.",
  },
  {
    title: "Крупному бизнесу",
    description:
      "Корпоративы, юбилеи компании, отраслевые праздники, деловые конференции и форумы.",
  },
  {
    title: "Иногородним клиентам",
    description:
      "Проведём мероприятие в Калининграде, пока вы работаете из другого города. Знаем регион — знаем, где будет круто.",
  },
];
---

<section id="audience" class="lab-glow-top relative px-6 py-14 md:px-12 md:py-20">
  <div class="mx-auto max-w-6xl">
    <div class="mb-10 max-w-3xl">
      <h2 class="text-3xl font-semibold leading-tight tracking-tight text-white md:text-5xl">
        Для кого мы работаем
      </h2>
      <span class="mt-4 inline-block h-1 w-12 bg-[#FFF200]"></span>
    </div>

    <div class="grid gap-5 md:grid-cols-3">
      {audiences.map((a) => (
        <MagicCard class="h-full p-6">
          <h3 class="mb-3 text-xl font-semibold text-white">{a.title}</h3>
          <p class="text-sm leading-relaxed text-white/65">{a.description}</p>
        </MagicCard>
      ))}
    </div>
  </div>
</section>
