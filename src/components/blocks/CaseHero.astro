---
/*
 * CaseHero — большое фото-обложка кейса с заголовком поверх затемнения,
 * клиент-лейблом и чипами фактов. Тёмная палитра (Phase 5.1 wave 4).
 *
 * Аспект 16:10 на десктопе, 16:8 на широких экранах — кинематографично,
 * не «баннер». На мобиле — портретный 4:5, чтобы все факты помещались.
 */
interface Props {
  title: string;
  client: string;
  slug: string;
  cover: string;
  chips: string[];
}

const { title, client, slug, cover, chips } = Astro.props;
const visibleChips = (chips || []).filter(Boolean);
---

<section class="relative w-full overflow-hidden">
  <div class="relative aspect-[4/5] w-full sm:aspect-[16/10] lg:aspect-[16/8]">
    <img
      src={`/assets/cases/${slug}/${cover}`}
      alt={`Обложка кейса: ${title}`}
      class="absolute inset-0 h-full w-full object-cover"
      loading="eager"
      fetchpriority="high"
    />
    {/* Затемнение снизу 60-70% высоты — чтобы текст читался */}
    <div class="absolute inset-0 bg-gradient-to-t from-black via-black/55 to-transparent"></div>

    <div class="absolute inset-x-0 bottom-0 px-6 pb-10 md:px-12 md:pb-16">
      <div class="mx-auto max-w-6xl">
        <p class="mb-3 text-xs font-semibold uppercase tracking-[0.25em] text-[#FFF200]">
          {client}
        </p>
        <h1 class="text-3xl font-semibold leading-tight tracking-tight text-white md:text-5xl lg:text-6xl">
          {title}
        </h1>

        {visibleChips.length > 0 && (
          <ul class="mt-6 flex flex-wrap gap-2 md:gap-3">
            {visibleChips.map((chip) => (
              <li class="inline-flex items-center rounded-full border border-white/15 bg-white/[0.08] px-3 py-1.5 text-xs text-white/85 backdrop-blur md:px-4 md:text-sm">
                {chip}
              </li>
            ))}
          </ul>
        )}
      </div>
    </div>
  </div>
</section>
