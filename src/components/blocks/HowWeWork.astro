---
/*
 * HowWeWork — шесть шагов работы в виде нумерованного вертикального таймлайна.
 * Тёмная версия (Wave 3): жёлтая вертикальная линия с прозрачными концами,
 * пятый шаг «День Х» выделен — жёлтый круг и жёлтая рамка вокруг заголовка.
 */
const steps = [
  {
    title: "Бриф",
    text: "30 минут разговора. Разбираем цели, формат, бюджет, ограничения.",
  },
  {
    title: "Концепция и смета",
    text: "За 3–5 рабочих дней присылаем первый вариант идеи и сметы — основу для обсуждения.",
  },
  {
    title: "Правки и утверждение",
    text: "Корректируем под ваши пожелания. Подписываем договор.",
  },
  {
    title: "Продакшн",
    text: "Бронируем площадку, подрядчиков, согласовываем технические детали.",
  },
  {
    title: "День Х",
    text: "Команда на месте. Тайминг, координация, форс-мажоры — наша задача.",
  },
  {
    title: "Отчёт",
    text: "Фото- и видеоматериалы, финансовый отчёт, ретроспектива.",
  },
];
---

<section id="how" class="relative px-6 py-14 md:px-12 md:py-20">
  <div class="mx-auto max-w-6xl">
    <div class="mb-10 max-w-3xl">
      <h2 class="text-3xl font-semibold leading-tight tracking-tight text-white md:text-5xl">
        Как мы работаем
      </h2>
      <span class="mt-4 inline-block h-1 w-12 bg-[#FFF200]"></span>
      <p class="mt-6 text-white/65 md:text-lg leading-relaxed">
        Шесть прозрачных шагов от&nbsp;первого звонка до&nbsp;итогового отчёта.
        На&nbsp;каждом шаге у&nbsp;вас есть точка контроля.
      </p>
    </div>

    <ol class="relative mx-auto max-w-3xl">
      <!-- вертикальная линия: градиент с прозрачными концами -->
      <div class="absolute left-5 top-5 bottom-5 w-px bg-gradient-to-b from-yellow-300/0 via-white/15 to-yellow-300/0"></div>

      {steps.map((s, i) => {
        const isClimax = s.title === "День Х";
        return (
          <li class="relative grid grid-cols-[2.5rem_1fr] gap-3 pb-10 last:pb-0 md:gap-5">
            <span
              class:list={[
                "relative z-10 inline-flex h-10 w-10 items-center justify-center rounded-full font-mono text-sm font-semibold transition-transform",
                isClimax
                  ? "bg-[#FFF200] text-black shadow-[0_0_28px_-6px_rgba(255,242,0,0.7)]"
                  : "border border-white/15 bg-[#0B0B10] text-[#FFF200]",
              ]}
            >
              {String(i + 1).padStart(2, "0")}
            </span>
            <div class="pt-1.5">
              <h3
                class:list={[
                  "text-lg font-semibold tracking-tight md:text-xl",
                  isClimax
                    ? "inline-block rounded-lg border border-[#FFF200]/55 bg-[#FFF200]/[0.06] px-3 py-1 text-[#FFF200] shadow-[0_0_22px_-10px_rgba(255,242,0,0.6)]"
                    : "text-white",
                ]}
              >
                {s.title}
              </h3>
              <p class="mt-2 max-w-xl text-sm leading-relaxed text-white/60 md:text-base">
                {s.text}
              </p>
            </div>
          </li>
        );
      })}
    </ol>
  </div>
</section>
