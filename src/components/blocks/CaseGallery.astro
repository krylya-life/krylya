---
import Container from "../Container.astro";
import Section from "../Section.astro";

interface Props {
  photos: string[];
  slug: string;
  title: string;
}

const { photos, slug, title } = Astro.props;
const visible = photos.slice(0, 12);
---

{visible.length > 0 && (
  <Section class="bg-white">
    <Container>
      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-3 md:gap-4">
        {visible.map((photo, i) => (
          <div class="aspect-[4/3] overflow-hidden bg-gray-light/30">
            <img
              src={`/assets/cases/${slug}/${photo}`}
              alt={`${title} — фото ${i + 1}`}
              class="w-full h-full object-cover"
              loading={i < 3 ? "eager" : "lazy"}
            />
          </div>
        ))}
      </div>
    </Container>
  </Section>
)}
