---
/*
 * CaseGallery — встраиваемая сетка фото по 3 в ряд (до 15). Клик по фото открывает
 * его во весь экран (лайтбокс с листанием). Без собственной «шапки» и отступов —
 * заголовок и расположение задаёт родитель (см. cases/[slug].astro, правая колонка).
 */
import Picture from "../Picture.astro";
import manifest from "../../data/image-manifest.json";

interface Props {
  photos: string[];
  slug: string;
  title?: string;
}

const { photos, slug, title } = Astro.props;
const visible = (photos || []).slice(0, 15);
const base = `/assets/cases/${slug}`;

// Для лайтбокса (фото во весь экран) отдаём полный WebP, если он сгенерирован,
// а оригинал оставляем запасным — на случай браузера без поддержки WebP.
const sizesByPath = manifest as Record<string, { full: number; thumb: number }>;
const fullSrc = (photo: string) => {
  const original = `${base}/${photo}`;
  return sizesByPath[original]
    ? original.replace(/\.(jpe?g|png)$/i, ".webp")
    : original;
};
---

{visible.length > 0 && (
  <div class="lb-root">
    <div class="grid grid-cols-3 gap-2 sm:gap-3">
      {visible.map((photo, i) => (
        <button
          type="button"
          class="lb-thumb group relative aspect-square cursor-zoom-in overflow-hidden rounded-lg bg-white/[0.03]"
          data-full={fullSrc(photo)}
          data-fallback={`${base}/${photo}`}
          aria-label={`Открыть фото ${i + 1}`}
        >
          <Picture
            src={`${base}/${photo}`}
            alt={title ? `${title} — фото ${i + 1}` : `Фото с площадки ${i + 1}`}
            class="absolute inset-0 h-full w-full object-cover transition-transform duration-500 ease-out group-hover:scale-105"
            sizes="(min-width: 1024px) 15vw, 30vw"
            loading={i < 3 ? "eager" : "lazy"}
          />
        </button>
      ))}
    </div>

    {/* Лайтбокс — открывается по клику на фото */}
    <div
      class="lb-overlay fixed inset-0 z-50 hidden items-center justify-center bg-black/90 p-4 backdrop-blur-sm"
      role="dialog"
      aria-modal="true"
      aria-label="Просмотр фото"
    >
      <button
        type="button"
        class="lb-close absolute right-4 top-4 flex h-11 w-11 items-center justify-center rounded-full border border-white/20 bg-white/10 text-2xl text-white transition hover:bg-white/20"
        aria-label="Закрыть"
      >&times;</button>
      <button
        type="button"
        class="lb-prev absolute left-3 flex h-12 w-12 items-center justify-center rounded-full border border-white/20 bg-white/10 text-3xl text-white transition hover:bg-white/20 md:left-6"
        aria-label="Предыдущее фото"
      >&lsaquo;</button>
      <img class="lb-image max-h-[88vh] max-w-[92vw] rounded-lg object-contain" src="" alt="" />
      <button
        type="button"
        class="lb-next absolute right-3 flex h-12 w-12 items-center justify-center rounded-full border border-white/20 bg-white/10 text-3xl text-white transition hover:bg-white/20 md:right-6"
        aria-label="Следующее фото"
      >&rsaquo;</button>
    </div>
  </div>
)}

<script>
  document.querySelectorAll(".lb-root").forEach((root) => {
    const thumbs = Array.from(root.querySelectorAll(".lb-thumb"));
    const overlay = root.querySelector(".lb-overlay");
    if (!overlay || thumbs.length === 0) return;
    const srcs = thumbs.map((t) => (t as HTMLElement).dataset.full || "");
    const fallbacks = thumbs.map((t) => (t as HTMLElement).dataset.fallback || "");
    const imgEl = overlay.querySelector(".lb-image") as HTMLImageElement;
    let current = 0;

    // Если браузер не осилил WebP — молча подставляем исходный JPEG
    imgEl.addEventListener("error", () => {
      const fallback = fallbacks[current];
      if (fallback && imgEl.src !== new URL(fallback, location.href).href) {
        imgEl.src = fallback;
      }
    });

    const show = (i: number) => {
      current = (i + srcs.length) % srcs.length;
      imgEl.src = srcs[current];
    };
    const open = (i: number) => {
      show(i);
      overlay.classList.remove("hidden");
      overlay.classList.add("flex");
      document.body.style.overflow = "hidden";
    };
    const close = () => {
      overlay.classList.add("hidden");
      overlay.classList.remove("flex");
      imgEl.src = "";
      document.body.style.overflow = "";
    };

    thumbs.forEach((t, i) => t.addEventListener("click", () => open(i)));
    overlay.querySelector(".lb-close")?.addEventListener("click", close);
    overlay.querySelector(".lb-prev")?.addEventListener("click", (e) => {
      e.stopPropagation();
      show(current - 1);
    });
    overlay.querySelector(".lb-next")?.addEventListener("click", (e) => {
      e.stopPropagation();
      show(current + 1);
    });
    overlay.addEventListener("click", (e) => {
      if (e.target === overlay) close();
    });
    document.addEventListener("keydown", (e) => {
      if (overlay.classList.contains("hidden")) return;
      if (e.key === "Escape") close();
      if (e.key === "ArrowLeft") show(current - 1);
      if (e.key === "ArrowRight") show(current + 1);
    });
  });
</script>
