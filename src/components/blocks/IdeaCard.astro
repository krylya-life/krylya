---
/*
 * IdeaCard — карточка статьи для витрины /идеи/ (образец карточки cases/index).
 * Обложка 4:3 + eyebrow (человекочитаемая рубрика) + заголовок. Тёмный стиль.
 */
import type { CollectionEntry } from "astro:content";
import Picture from "../Picture.astro";

interface Props {
  idea: CollectionEntry<"ideas">;
  /** Человекочитаемая метка рубрики, например «Как организовать». */
  rubricLabel: string;
}

const { idea, rubricLabel } = Astro.props;
const d = idea.data;
// Метка над карточкой: своя у статьи (eyebrow) либо метка рубрики как fallback.
const eyebrow = d.eyebrow ?? rubricLabel;
---

<a
  href={`/идеи/${d.slug}/`}
  class="lab-cursor-wings group block no-underline"
>
  <div class="relative aspect-[4/3] overflow-hidden rounded-xl">
    <Picture
      src={`/assets/ideas/${d.slug}/${d.cover}`}
      alt={d.coverAlt}
      class="absolute inset-0 h-full w-full object-cover transition-transform duration-700 ease-out group-hover:scale-105"
      sizes="(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 90vw"
      loading="lazy"
    />
  </div>
  <p
    class="mt-4 text-[10px] font-semibold uppercase tracking-[0.2em] text-[#FFF200]"
  >
    {eyebrow}
  </p>
  <h3
    class="mt-1.5 text-base font-semibold leading-tight tracking-tight text-white md:text-lg"
  >
    {d.title}
  </h3>
  <p class="mt-1.5 text-sm leading-relaxed text-white/55">{d.description}</p>
</a>
