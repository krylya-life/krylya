---
import Container from "../Container.astro";
import Section from "../Section.astro";
import Heading from "../Heading.astro";
import Button from "../Button.astro";
import { getCollection } from "astro:content";

// На главную выносим только согласованные кейсы — `.business/products/overview.md`:
// АЭРО, ВКЛЮЧИ и фестиваль «ДОМ». Помечены featured: true.
const all = await getCollection("cases");
const cases = all
  .filter((c) => c.data.featured)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3);
---

<Section class="bg-gray-light/15">
  <Container>
    <div class="md:flex md:items-end md:justify-between gap-8">
      <div>
        <Heading level={2} accent>Кейсы</Heading>
        <p class="mt-6 max-w-2xl text-lg text-gray-dark leading-relaxed">
          Несколько недавних проектов — задача, решение и материалы с площадки.
        </p>
      </div>
      <Button href="/cases/" variant="secondary" class="mt-6 md:mt-0 self-start md:self-auto whitespace-nowrap">
        Все кейсы
      </Button>
    </div>

    {cases.length > 0 ? (
      <div class="mt-12 grid gap-1 md:grid-cols-3">
        {cases.map((c) => (
          <a
            href={`/cases/${c.data.slug}/`}
            class="group relative block overflow-hidden bg-black aspect-[4/3]"
          >
            <img
              src={`/assets/cases/${c.data.slug}/${c.data.cover}`}
              alt={`Обложка: ${c.data.title}`}
              class="absolute inset-0 w-full h-full object-cover opacity-90 group-hover:opacity-100 group-hover:scale-105 transition-all duration-500"
              loading="lazy"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/30 to-transparent"></div>
            <div class="absolute inset-x-0 bottom-0 p-6 md:p-8">
              <span class="text-xs font-semibold uppercase tracking-wider text-yellow">
                {c.data.client}
              </span>
              <h3 class="mt-2 text-xl md:text-2xl font-semibold text-white leading-tight">
                {c.data.title}
              </h3>
            </div>
          </a>
        ))}
      </div>
    ) : (
      <p class="mt-12 text-gray-dark italic">Кейсы появятся в Phase 5.</p>
    )}
  </Container>
</Section>
