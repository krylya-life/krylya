---
/*
 * CasesPreview — карусель кейсов на главной.
 * Плавная бесконечная прокрутка по кругу (auto-marquee) + стрелки ‹ ›.
 * Пауза при наведении/фокусе, уважает prefers-reduced-motion. Карточки кликабельны.
 * Тёмная палитра, lab-cursor-wings — курсор «крылья» при наведении.
 */
import { getCollection } from "astro:content";

const all = await getCollection("cases");
const cases = all.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
// Дублируем список — для бесшовной прокрутки по кругу.
const loop = [...cases, ...cases];
---

<section id="cases" class="lab-bg-alt relative px-6 py-14 md:px-12 md:py-20">
  <div class="mx-auto max-w-6xl">
    <div class="mb-10 flex flex-wrap items-end justify-between gap-6">
      <div class="max-w-2xl">
        <h2 class="text-3xl font-semibold leading-tight tracking-tight text-white md:text-5xl">
          Кейсы
        </h2>
        <span class="mt-4 inline-block h-1 w-12 bg-[#FFF200]"></span>
        <p class="mt-6 max-w-2xl text-white/65 md:text-lg leading-relaxed">
          Несколько недавних проектов — задача, решение и&nbsp;материалы с&nbsp;площадки.
        </p>
      </div>
      <a
        href="/cases/"
        class="inline-flex items-center gap-2 rounded-full border border-white/15 bg-white/[0.03] px-5 py-2.5 text-sm font-medium text-white/85 no-underline transition hover:border-white/30 hover:text-white"
      >
        Все кейсы
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M13 5l7 7-7 7"/></svg>
      </a>
    </div>

    {cases.length > 0 ? (
      <div class="relative" data-carousel>
        <div data-track class="no-scrollbar flex gap-4 overflow-x-auto">
          {loop.map((c, i) => (
            <a
              href={`/cases/${c.data.slug}/`}
              aria-hidden={i >= cases.length ? "true" : undefined}
              tabindex={i >= cases.length ? -1 : undefined}
              class="group lab-cursor-wings relative block aspect-[4/5] w-[72%] shrink-0 overflow-hidden rounded-2xl no-underline sm:w-[300px]"
            >
              <img
                src={`/assets/cases/${c.data.slug}/${c.data.cover}`}
                alt={c.data.title}
                class="absolute inset-0 h-full w-full object-cover transition-transform duration-700 ease-out group-hover:scale-105"
                loading="lazy"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-black/85 via-black/35 to-transparent"></div>
              <div class="absolute inset-x-0 bottom-0 p-5">
                <p class="mb-1.5 text-[10px] font-semibold uppercase tracking-[0.18em] text-[#FFF200]">
                  {c.data.eyebrow || c.data.client}
                </p>
                <h3 class="text-base font-semibold leading-tight tracking-tight text-white md:text-lg">
                  {c.data.title}
                </h3>
              </div>
            </a>
          ))}
        </div>

        <button
          type="button"
          data-prev
          aria-label="Предыдущий кейс"
          class="absolute left-1 top-1/2 hidden h-11 w-11 -translate-y-1/2 items-center justify-center rounded-full border border-white/20 bg-black/50 text-2xl text-white backdrop-blur transition hover:bg-black/70 sm:flex"
        >&lsaquo;</button>
        <button
          type="button"
          data-next
          aria-label="Следующий кейс"
          class="absolute right-1 top-1/2 hidden h-11 w-11 -translate-y-1/2 items-center justify-center rounded-full border border-white/20 bg-black/50 text-2xl text-white backdrop-blur transition hover:bg-black/70 sm:flex"
        >&rsaquo;</button>
      </div>
    ) : (
      <p class="mt-12 text-white/60 italic">Кейсы появятся скоро.</p>
    )}
  </div>
</section>

<style>
  .no-scrollbar {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
  .no-scrollbar::-webkit-scrollbar {
    display: none;
  }
</style>

<script>
  document.querySelectorAll("[data-carousel]").forEach((root) => {
    const track = root.querySelector("[data-track]") as HTMLElement;
    if (!track) return;
    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    // Ширина одного полного набора карточек (список продублирован дважды).
    const setWidth = () => track.scrollWidth / 2;
    const step = () => {
      const first = track.firstElementChild as HTMLElement | null;
      const gap = parseFloat(getComputedStyle(track).columnGap || "16") || 16;
      return first ? first.offsetWidth + gap : 320;
    };

    // Бесшовная прокрутка по кругу. Держим позицию в «коридоре» вокруг
    // второго набора карточек [0.5w … 1.5w]. Как только вышли за коридор —
    // мгновенно перескакиваем на идентичную позицию ровно на ширину набора.
    // Строгие неравенства + приземление в центр коридора не дают перескоку
    // случиться на самой границе (иначе лента «пинг-понгует» туда-сюда).
    let wrapping = false;
    track.addEventListener("scroll", () => {
      if (wrapping) return;
      const w = setWidth();
      if (w <= 0) return;
      if (track.scrollLeft < w * 0.5) {
        wrapping = true;
        track.scrollLeft += w;
        requestAnimationFrame(() => (wrapping = false));
      } else if (track.scrollLeft > w * 1.5) {
        wrapping = true;
        track.scrollLeft -= w;
        requestAnimationFrame(() => (wrapping = false));
      }
    });

    // Старт со второго набора — чтобы листать в обе стороны без рывка.
    requestAnimationFrame(() => {
      track.scrollLeft = setWidth();
    });

    root.querySelector("[data-next]")?.addEventListener("click", () => {
      track.scrollBy({ left: step(), behavior: "smooth" });
    });
    root.querySelector("[data-prev]")?.addEventListener("click", () => {
      track.scrollBy({ left: -step(), behavior: "smooth" });
    });

    // Плавное автодвижение по кругу.
    let paused = false;
    root.addEventListener("pointerenter", () => (paused = true));
    root.addEventListener("pointerleave", () => (paused = false));
    root.addEventListener("focusin", () => (paused = true));
    root.addEventListener("focusout", () => (paused = false));

    if (!reduce) {
      const tick = () => {
        if (!paused) track.scrollLeft += 0.5;
        requestAnimationFrame(tick);
      };
      requestAnimationFrame(tick);
    }
  });
</script>
