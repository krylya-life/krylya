---
import Container from "../Container.astro";
import Section from "../Section.astro";
import Heading from "../Heading.astro";

const points = [
  {
    title: "Одна команда вместо десяти переговоров",
    text: "Площадка, кейтеринг, ведущий, техника, флористика — мы сводим графики, согласования и ожидания в одну линию. У вас остаётся один контакт вместо десятка телефонов в записной книжке.",
  },
  {
    title: "Прозрачная смета",
    text: "Подрядчики идут в смете отдельной строкой по реальной цене — вы видите, куда уходит каждый рубль. Наши 10% — плата за организационную работу: концепцию, поиск, бюджет, ведение проекта.",
  },
  {
    title: "Команда на площадке в день события",
    text: "Тайминг, подрядчики, форс-мажоры — наша зона ответственности. Вы общаетесь с гостями, мы держим всё остальное.",
  },
];
---

<Section>
  <Container>
    <Heading level={2} accent>
      «Под ключ» — буквально
    </Heading>

    <p class="mt-6 max-w-3xl text-lg text-gray-dark leading-relaxed">
      Концепция, площадка, подрядчики, бюджет, день события — на&nbsp;нашей стороне. Вы&nbsp;получаете готовое мероприятие, а&nbsp;не&nbsp;пакет задач, которые нужно довести до&nbsp;результата.
    </p>

    <div class="mt-12 grid gap-10 md:grid-cols-3">
      {points.map((point, i) => (
        <div>
          <span class="text-sm font-semibold text-yellow">0{i + 1}</span>
          <h3 class="mt-2 text-xl font-semibold text-black">{point.title}</h3>
          <p class="mt-3 text-gray-dark leading-relaxed">{point.text}</p>
        </div>
      ))}
    </div>
  </Container>
</Section>
