---
import Container from "./Container.astro";
import Logo from "./Logo.astro";

const phone = "+79118627957";
const phoneDisplay = "+7 911 862 7957";
const email = "wings.agency@yandex.ru";
const year = new Date().getFullYear();
---

<footer
  itemscope
  itemtype="https://schema.org/Organization"
  class="bg-black text-white py-12 md:py-16"
>
  <meta itemprop="name" content="Крылья" />
  <meta itemprop="legalName" content="ИП Вострикова Мария Валерьевна" />
  <meta itemprop="taxID" content="550209075500" />
  <meta itemprop="vatID" content="324390000038348" />
  <meta itemprop="url" content="https://крылья.life/" />

  <Container>
    <div class="grid gap-12 md:grid-cols-3">
      <div itemscope itemtype="https://schema.org/PostalAddress" itemprop="address">
        <Logo variant="horizontal-white" class="mb-4" asLink={false} />
        <p class="text-sm text-gray-light mb-3" itemprop="addressLocality">
          Калининград и область
        </p>
        <p class="text-sm mb-1">
          <a href={`tel:${phone}`} class="text-white hover:text-yellow transition-colors">
            <span itemprop="telephone">{phoneDisplay}</span>
          </a>
        </p>
        <p class="text-sm">
          <a href={`mailto:${email}`} class="text-white hover:text-yellow transition-colors">
            <span itemprop="email">{email}</span>
          </a>
        </p>
      </div>

      <nav>
        <h4 class="text-sm font-semibold uppercase tracking-wider text-gray-light mb-4">
          Навигация
        </h4>
        <ul class="space-y-2 text-sm">
          <li><a href="/services/" class="text-white hover:text-yellow transition-colors">Услуги</a></li>
          <li><a href="/cases/" class="text-white hover:text-yellow transition-colors">Кейсы</a></li>
          <li><a href="/about/" class="text-white hover:text-yellow transition-colors">О нас</a></li>
          <li><a href="/contacts/" class="text-white hover:text-yellow transition-colors">Контакты</a></li>
        </ul>
      </nav>

      <div>
        <h4 class="text-sm font-semibold uppercase tracking-wider text-gray-light mb-4">
          Реквизиты
        </h4>
        <p class="text-sm text-gray-light leading-relaxed">
          ИП Вострикова Мария Валерьевна<br />
          ИНН 550209075500<br />
          ОГРНИП 324390000038348
        </p>
        <p class="mt-4 text-sm">
          <a href="/privacy/" class="text-gray-light hover:text-yellow transition-colors">
            Политика обработки ПДн
          </a>
        </p>
      </div>
    </div>

    <div class="mt-12 pt-8 border-t border-gray-dark text-xs text-gray-light">
      © {year} Крылья. Все права защищены.
    </div>
  </Container>
</footer>
