---
import Container from "./Container.astro";
import Logo from "./Logo.astro";
import { business } from "../config/business.ts";

const year = new Date().getFullYear();
---

<footer
  itemscope
  itemtype="https://schema.org/Organization"
  class="bg-gray-dark text-white py-12 md:py-16 border-t-4 border-yellow"
>
  <meta itemprop="name" content={business.name} />
  <meta itemprop="legalName" content={business.legalName} />
  <meta itemprop="taxID" content={business.taxId} />
  <meta itemprop="vatID" content={business.ogrnip} />
  <meta itemprop="url" content={business.urlCyrillic} />

  <Container>
    <div class="grid gap-12 md:grid-cols-3">
      <div itemscope itemtype="https://schema.org/PostalAddress" itemprop="address">
        <Logo variant="horizontal-white" size="lg" class="mb-6" asLink={false} />
        <p class="text-sm text-gray-light mb-1" itemprop="addressLocality">
          {business.locality}
        </p>
        <p class="text-xs text-gray-light mb-3" itemprop="addressRegion">
          {business.region}
        </p>
        <p class="text-base mb-1">
          <a href={`tel:${business.phone}`} class="text-white hover:text-yellow transition-colors font-medium">
            <span itemprop="telephone">{business.phoneDisplay}</span>
          </a>
        </p>
        <p class="text-base">
          <a href={`mailto:${business.email}`} class="text-white hover:text-yellow transition-colors font-medium">
            <span itemprop="email">{business.email}</span>
          </a>
        </p>
      </div>

      <nav>
        <h4 class="text-sm font-semibold uppercase tracking-wider text-yellow mb-4">
          Навигация
        </h4>
        <ul class="space-y-2 text-sm">
          <li><a href="/services/" class="text-white hover:text-yellow transition-colors">Услуги</a></li>
          <li><a href="/cases/" class="text-white hover:text-yellow transition-colors">Кейсы</a></li>
          <li><a href="/about/" class="text-white hover:text-yellow transition-colors">О нас</a></li>
          <li><a href="/contacts/" class="text-white hover:text-yellow transition-colors">Контакты</a></li>
        </ul>
      </nav>

      <div>
        <h4 class="text-sm font-semibold uppercase tracking-wider text-yellow mb-4">
          Реквизиты
        </h4>
        <p class="text-sm text-gray-light leading-relaxed">
          {business.legalName}<br />
          ИНН {business.taxId}<br />
          ОГРНИП {business.ogrnip}
        </p>
        <p class="mt-4 text-sm">
          <a href="/privacy/" class="text-gray-light hover:text-yellow transition-colors">
            Политика обработки ПДн
          </a>
        </p>
      </div>
    </div>

    <div class="mt-12 pt-8 border-t border-gray-light/30 flex flex-col sm:flex-row justify-between gap-4 text-xs text-gray-light">
      <span>© {year} Крылья. Все права защищены.</span>
      <span>Калининград</span>
    </div>
  </Container>
</footer>
