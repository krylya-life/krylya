---
import { business } from "../config/business.ts";

const orgId = `${business.url}/#organization`;
const localId = `${business.url}/#localbusiness`;

const graph = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": orgId,
      name: business.name,
      legalName: business.legalName,
      url: business.url,
      // Кириллица через конкатенацию: new URL() нормализует IDN в Punycode (WHATWG URL API)
      logo: business.url + "/brand/wings-logo-horizontal.png",
      taxID: business.taxId,
      // ОГРНИП — не vatID (это ИНН плательщика НДС), а identifier (аудит 01, №15)
      identifier: { "@type": "PropertyValue", propertyID: "ОГРНИП", value: business.ogrnip },
      foundingDate: business.foundingDate,
      founder: { "@type": "Person", name: business.founder },
      contactPoint: [
        {
          "@type": "ContactPoint",
          telephone: business.phone,
          email: business.email,
          contactType: "customer service",
          areaServed: business.countryCode,
          availableLanguage: business.languages,
        },
      ],
      areaServed: {
        "@type": "AdministrativeArea",
        name: business.region,
      },
    },
    {
      "@type": "WebSite",
      "@id": `${business.url}/#website`,
      url: business.url,
      name: business.name,
      alternateName: ["Крылья — ивент-агентство", "Ивент-агентство Крылья", "крылья.life"],
      inLanguage: "ru",
      publisher: { "@id": orgId },
    },
    {
      "@type": "LocalBusiness",
      "@id": localId,
      name: business.name,
      url: business.url,
      telephone: business.phone,
      email: business.email,
      image: business.url + "/brand/og-wings-yellow.png",
      logo: business.url + "/brand/wings-logo-horizontal.png",
      priceRange: business.priceRange,
      address: {
        "@type": "PostalAddress",
        streetAddress: business.streetAddress,
        addressLocality: business.locality,
        addressRegion: business.region,
        addressCountry: business.countryCode,
      },
      areaServed: {
        "@type": "AdministrativeArea",
        name: business.region,
      },
      openingHoursSpecification: [
        {
          "@type": "OpeningHoursSpecification",
          dayOfWeek: business.hours.days,
          opens: business.hours.opens,
          closes: business.hours.closes,
        },
      ],
      parentOrganization: { "@id": orgId },
    },
  ],
};
---

<script type="application/ld+json" is:inline set:html={JSON.stringify(graph)} />
