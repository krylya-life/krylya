---
// FAQPage из раздела вопросов услуги (аудит 01, №27). Источник — сам markdown,
// поэтому разметка всегда совпадает с видимым текстом.
// Поддерживает два формата: «### Вопрос» + абзацы и «**«Вопрос»** ответ» в одном абзаце.
import { business } from "../config/business.ts";

interface Props {
  slug: string;
  body: string;
}

const { slug, body } = Astro.props;

const clean = (s: string) =>
  s
    .replace(/&nbsp;/g, " ")
    .replace(/\[([^\]]+)\]\([^)]+\)/g, "$1")
    .replace(/\*\*/g, "")
    .replace(/\s+/g, " ")
    .trim();

const section = body.match(/^## (?:Что обычно беспокоит заказчиков|Частые вопросы)\s*\n([\s\S]*?)(?=^## |(?![\s\S]))/m)?.[1] ?? "";

const items: { q: string; a: string }[] = [];
for (const m of section.matchAll(/^### (.+)\n([\s\S]*?)(?=^### |(?![\s\S]))/gm)) {
  items.push({ q: clean(m[1]), a: clean(m[2]) });
}
for (const m of section.matchAll(/^\*\*«(.+?)»\*\*\s*(.+)$/gm)) {
  items.push({ q: clean(m[1]), a: clean(m[2]) });
}

const json = items.length && {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "@id": `${business.url}/services/${slug}/#faq`,
  mainEntity: items.map(({ q, a }) => ({
    "@type": "Question",
    name: q,
    acceptedAnswer: { "@type": "Answer", text: a },
  })),
};
---

{json && <script type="application/ld+json" is:inline set:html={JSON.stringify(json)} />}
