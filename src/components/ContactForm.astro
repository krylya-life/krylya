---
/*
 * ContactForm — основная форма заявок.
 * Phase 7: восстановлена после переезда на Cloudflare Pages. Отправляет на
 * /api/contact (Cloudflare Pages Function в functions/api/contact.ts), которая
 * шлёт уведомление в Telegram-бот @krylya_zayavki_bot.
 *
 * Стили адаптированы под тёмную палитру (Phase 5.1):
 * - инпуты: bg-white/[0.03] + border white/10
 * - подписи: text-white
 * - placeholder: text-white/40
 * - подсказки и второстепенный текст: text-white/55
 * - акцент валидации: жёлтый #FFF200
 * - submit: жёлтая кнопка bg-[#FFF200] (как CTA в ContactBlock)
 */

interface Props {
  /** ID формы (по умолчанию 'contact'). Передаётся в Telegram-уведомление. */
  name?: string;
}
const { name = "contact" } = Astro.props;
---

<form name={name} method="POST" action="/api/contact" class="space-y-5" data-contact-form>
  <input type="hidden" name="form-name" value={name} />

  {/* Honeypot — невидимое поле, заполняют только боты */}
  <p class="hidden" aria-hidden="true">
    <label>
      Не заполняйте это поле:
      <input name="bot-field" tabindex="-1" autocomplete="off" />
    </label>
  </p>

  <div class="grid gap-5 sm:grid-cols-2">
    <label class="block">
      <span class="block text-sm font-medium text-white mb-2">
        Имя <span class="text-[#FFF200]">*</span>
      </span>
      <input
        type="text"
        name="name"
        required
        autocomplete="name"
        maxlength="80"
        class="w-full rounded-lg border border-white/10 bg-white/[0.03] px-4 py-3 text-white placeholder:text-white/40 focus:border-[#FFF200]/60 focus:bg-white/[0.05] focus:outline-none focus:ring-2 focus:ring-[#FFF200]/30 transition-colors"
        placeholder="Как к вам обращаться"
      />
    </label>

    <label class="block">
      <span class="block text-sm font-medium text-white mb-2">
        Телефон <span class="text-[#FFF200]">*</span>
      </span>
      <input
        type="tel"
        name="phone"
        id="phone-input"
        required
        autocomplete="tel"
        inputmode="tel"
        maxlength="20"
        pattern="\\+?[78](?:[\\s\\-()]*\\d){10}"
        title="Российский номер: +7, 7 или 8, затем 10 цифр. Пример: +7 911 862 79 57"
        class="w-full rounded-lg border border-white/10 bg-white/[0.03] px-4 py-3 text-white placeholder:text-white/40 focus:border-[#FFF200]/60 focus:bg-white/[0.05] focus:outline-none focus:ring-2 focus:ring-[#FFF200]/30 transition-colors"
        placeholder="+7 911 862 79 57"
      />
      <span id="phone-hint" class="mt-1 block text-xs text-white/55">
        Российский номер: +7, 7 или 8 + 10 цифр
      </span>
    </label>
  </div>

  <label class="block">
    <span class="block text-sm font-medium text-white mb-2">
      Email <span class="text-xs font-normal text-white/45">(необязательно)</span>
    </span>
    <input
      type="email"
      name="email"
      autocomplete="email"
      maxlength="120"
      class="w-full rounded-lg border border-white/10 bg-white/[0.03] px-4 py-3 text-white placeholder:text-white/40 focus:border-[#FFF200]/60 focus:bg-white/[0.05] focus:outline-none focus:ring-2 focus:ring-[#FFF200]/30 transition-colors"
      placeholder="email@example.com"
    />
  </label>

  <label class="block">
    <span class="block text-sm font-medium text-white mb-2">
      Расскажите о&nbsp;мероприятии <span class="text-[#FFF200]">*</span>
    </span>
    <textarea
      name="message"
      required
      rows="4"
      maxlength="500"
      minlength="10"
      class="w-full resize-y rounded-lg border border-white/10 bg-white/[0.03] px-4 py-3 text-white placeholder:text-white/40 focus:border-[#FFF200]/60 focus:bg-white/[0.05] focus:outline-none focus:ring-2 focus:ring-[#FFF200]/30 transition-colors"
      placeholder="Тип мероприятия, примерная дата, количество гостей, особые пожелания. Чем подробнее, тем точнее смета."
    ></textarea>
    <span class="mt-1 block text-xs text-white/55">От&nbsp;10 до&nbsp;500 символов</span>
  </label>

  <label class="flex cursor-pointer items-start gap-3">
    <input
      type="checkbox"
      name="consent"
      required
      value="yes"
      class="mt-1 h-4 w-4 flex-shrink-0 accent-[#FFF200]"
    />
    <span class="text-sm text-white/65">
      Согласен с&nbsp;обработкой персональных данных в&nbsp;соответствии с&nbsp;
      <a
        href="/privacy/"
        class="text-white underline decoration-[#FFF200]/50 underline-offset-4 transition hover:decoration-[#FFF200]"
      >
        Политикой конфиденциальности
      </a>
      &nbsp;(152-ФЗ).
    </span>
  </label>

  <div class="flex flex-col gap-4 pt-1 sm:flex-row sm:items-center">
    <button
      type="submit"
      data-submit-btn
      class="inline-flex min-h-[44px] items-center justify-center rounded-full bg-[#FFF200] px-7 py-3.5 text-sm font-semibold text-black transition-colors hover:bg-[#FFF566] disabled:cursor-not-allowed disabled:opacity-60"
    >
      Оставить заявку
    </button>
    <span class="text-sm text-white/55">
      Ответим в&nbsp;течение рабочего дня. Без спама и&nbsp;рассылок.
    </span>
  </div>

  <p class="hidden text-sm text-red-400" role="alert" data-form-error>
    Не удалось отправить заявку. Позвоните нам: +7&nbsp;911&nbsp;862&nbsp;79&nbsp;57.
  </p>
</form>

<script is:inline>
  // 1) Live-валидация телефона: фильтр символов + подсветка статуса (зелёный/красный).
  // 2) Перехват submit — отправка через fetch на /api/contact (Cloudflare Pages Function),
  //    при успехе — переход на /thanks/.
  (function () {
    const form = document.querySelector("form[data-contact-form]");
    const phone = document.getElementById("phone-input");
    const hint = document.getElementById("phone-hint");
    const submitBtn = form && form.querySelector("[data-submit-btn]");
    const errorEl = form && form.querySelector("[data-form-error]");
    if (!form || !phone || !hint) return;

    const ALLOWED = /[^\d+\-()\s]/g;
    const PHONE_RE = /^\+?[78](?:[\s\-()]*\d){10}$/;

    const clean = (v) => v.replace(ALLOWED, "");

    function update() {
      const v = phone.value.trim();
      if (v.length === 0) {
        phone.style.borderColor = "";
        hint.textContent = "Российский номер: +7, 7 или 8 + 10 цифр";
        hint.style.color = "";
        return;
      }
      if (PHONE_RE.test(v)) {
        phone.style.borderColor = "#4ade80"; // green-400 на тёмном фоне
        hint.textContent = "✓ Формат верный";
        hint.style.color = "#4ade80";
      } else {
        phone.style.borderColor = "#f87171"; // red-400 на тёмном фоне
        hint.textContent = "Нужен формат: +7 911 862 79 57 (или 8 911...)";
        hint.style.color = "#f87171";
      }
    }

    phone.addEventListener("input", (e) => {
      const t = e.target;
      const cleaned = clean(t.value);
      if (cleaned !== t.value) t.value = cleaned;
      update();
    });

    phone.addEventListener("paste", (e) => {
      e.preventDefault();
      const text = (e.clipboardData || window.clipboardData).getData("text");
      const cleaned = clean(text);
      const start = phone.selectionStart || 0;
      const end = phone.selectionEnd || 0;
      phone.value = phone.value.slice(0, start) + cleaned + phone.value.slice(end);
      phone.selectionStart = phone.selectionEnd = start + cleaned.length;
      update();
    });

    phone.addEventListener("blur", update);

    form.addEventListener("submit", async (e) => {
      e.preventDefault();

      // Валидация телефона как страховка к pattern
      const v = phone.value.trim();
      if (!PHONE_RE.test(v)) {
        update();
        phone.focus();
        phone.scrollIntoView({ behavior: "smooth", block: "center" });
        return;
      }

      if (errorEl) errorEl.classList.add("hidden");
      if (submitBtn) {
        submitBtn.setAttribute("disabled", "true");
        submitBtn.textContent = "Отправляем…";
      }

      try {
        const formData = new FormData(form);
        const res = await fetch("/api/contact", {
          method: "POST",
          body: formData,
        });

        if (res.ok) {
          window.location.href = "/thanks/";
          return;
        }

        if (errorEl) errorEl.classList.remove("hidden");
        if (submitBtn) {
          submitBtn.removeAttribute("disabled");
          submitBtn.textContent = "Оставить заявку";
        }
      } catch (err) {
        if (errorEl) errorEl.classList.remove("hidden");
        if (submitBtn) {
          submitBtn.removeAttribute("disabled");
          submitBtn.textContent = "Оставить заявку";
        }
      }
    });
  })();
</script>
