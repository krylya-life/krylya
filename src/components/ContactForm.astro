// Полная форма с отправкой в Telegram вернётся, как только настроим автодеплой.
import Button from "./Button.astro";

interface Props {
  name?: string;
}
const { name = "contact" } = Astro.props;
---

<div class="space-y-4">
  <p class="text-base text-gray-dark leading-relaxed">
    Сейчас форма онлайн-заявок временно отключена. Свяжитесь напрямую — ответим в&nbsp;течение рабочего дня.
  </p>

  <div class="grid gap-3 sm:grid-cols-2">
    <a
      href="tel:+79118627957"
      class="flex items-center gap-3 px-5 py-4 bg-yellow text-black font-semibold no-underline hover:opacity-90 transition-opacity"
    >
      <span class="text-xl">📞</span>
      <span>+7 911 862 79 57</span>
    </a>

    <a
      href="https://t.me/mashavostrik"
      target="_blank"
      rel="noopener noreferrer"
      class="flex items-center gap-3 px-5 py-4 bg-white border border-gray-light text-black font-semibold no-underline hover:border-yellow transition-colors"
    >
      <span class="text-xl">✈️</span>
      <span>Telegram @mashavostrik</span>
    </a>
  </div>

  <a
    href="mailto:wings.agency@yandex.ru"
    class="inline-flex items-center gap-2 text-sm text-gray-dark hover:text-black underline underline-offset-2"
  >
    или&nbsp;на&nbsp;почту: wings.agency@yandex.ru
