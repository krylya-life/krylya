---
import Button from "./Button.astro";

interface Props {
  /** ID формы для Netlify (по умолчанию 'contact'). Можно сделать разные на разных страницах. */
  name?: string;
}
const { name = "contact" } = Astro.props;

// Используем спред-атрибуты, чтобы Astro точно сохранил data-netlify
// (при инлайн-записи Astro иногда стрипает data-* со значением "true").
const formAttrs = {
  name,
  method: "POST",
  action: "/thanks/",
  "data-netlify": "true",
  "data-netlify-honeypot": "bot-field",
  class: "space-y-6",
};
---

<form {...formAttrs}>
  {/* Скрытое поле для Netlify — нужно знать имя формы при сабмите */}
  <input type="hidden" name="form-name" value={name} />

  {/* Honeypot — невидимое поле, заполняют только боты */}
  <p class="hidden" aria-hidden="true">
    <label>
      Не заполняйте это поле:
      <input name="bot-field" tabindex="-1" autocomplete="off" />
    </label>
  </p>

  <div class="grid gap-6 sm:grid-cols-2">
    <label class="block">
      <span class="block text-sm font-medium text-black mb-2">
        Имя <span class="text-yellow">*</span>
      </span>
      <input
        type="text"
        name="name"
        required
        autocomplete="name"
        maxlength="80"
        class="w-full px-4 py-3 bg-white border border-gray-light rounded-md text-black placeholder:text-gray-light focus:outline-none focus:border-black focus:ring-2 focus:ring-yellow"
        placeholder="Как к вам обращаться"
      />
    </label>

    <label class="block">
      <span class="block text-sm font-medium text-black mb-2">
        Телефон <span class="text-yellow">*</span>
      </span>
      <input
        type="tel"
        name="phone"
        id="phone-input"
        required
        autocomplete="tel"
        inputmode="tel"
        maxlength="20"
        pattern="\\+?[78](?:[\\s\\-()]*\\d){10}"
        title="Российский номер: +7, 7 или 8, затем 10 цифр. Пример: +7 911 862 79 57"
        class="w-full px-4 py-3 bg-white border border-gray-light rounded-md text-black placeholder:text-gray-light focus:outline-none focus:border-black focus:ring-2 focus:ring-yellow data-[state=invalid]:border-red-500 data-[state=valid]:border-green-600"
        placeholder="+7 911 862 79 57"
      />
      <span id="phone-hint" class="block text-xs text-gray-light mt-1">
        Российский номер: +7, 7 или 8 + 10 цифр
      </span>
    </label>
  </div>

  <label class="block">
    <span class="block text-sm font-medium text-black mb-2">
      Email <span class="text-gray-light text-xs font-normal">(необязательно)</span>
    </span>
    <input
      type="email"
      name="email"
      autocomplete="email"
      maxlength="120"
      class="w-full px-4 py-3 bg-white border border-gray-light rounded-md text-black placeholder:text-gray-light focus:outline-none focus:border-black focus:ring-2 focus:ring-yellow"
      placeholder="email@example.com"
    />
  </label>

  <label class="block">
    <span class="block text-sm font-medium text-black mb-2">
      Расскажите о мероприятии <span class="text-yellow">*</span>
    </span>
    <textarea
      name="message"
      required
      rows="4"
      maxlength="500"
      minlength="10"
      class="w-full px-4 py-3 bg-white border border-gray-light rounded-md text-black placeholder:text-gray-light focus:outline-none focus:border-black focus:ring-2 focus:ring-yellow resize-y"
      placeholder="Тип мероприятия, примерная дата, количество гостей, особые пожелания. Чем подробнее, тем точнее смета."
    ></textarea>
    <span class="block text-xs text-gray-light mt-1">От 10 до 500 символов</span>
  </label>

  <label class="flex items-start gap-3 cursor-pointer">
    <input
      type="checkbox"
      name="consent"
      required
      value="yes"
      class="mt-1 h-4 w-4 accent-yellow flex-shrink-0"
    />
    <span class="text-sm text-gray-dark">
      Согласен с обработкой персональных данных в соответствии с
      <a href="/privacy/" class="text-black hover:text-yellow underline">
        Политикой конфиденциальности
      </a>
      (152-ФЗ).
    </span>
  </label>

  <div class="flex flex-col sm:flex-row sm:items-center gap-4">
    <Button type="submit" variant="primary">Оставить заявку</Button>
    <span class="text-sm text-gray-dark">
      Ответим в течение рабочего дня. Без спама и рассылок.
    </span>
  </div>
</form>

<script is:inline>
  // Валидация поля телефона: фильтр символов на лету + проверка формата.
  // pattern в HTML работает только на submit — этот скрипт ещё и подсвечивает
  // поле на лету: красным если формат не подходит, зелёным когда всё ок.
  (function () {
    const phone = document.getElementById("phone-input");
    const hint = document.getElementById("phone-hint");
    if (!phone || !hint) return;

    const ALLOWED = /[^\d+\-()\s]/g;
    const PHONE_RE = /^\+?[78](?:[\s\-()]*\d){10}$/;

    const clean = (v) => v.replace(ALLOWED, "");

    function update() {
      const v = phone.value.trim();
      if (v.length === 0) {
        phone.style.borderColor = "";
        hint.textContent = "Российский номер: +7, 7 или 8 + 10 цифр";
        hint.style.color = "";
        return;
      }
      if (PHONE_RE.test(v)) {
        phone.style.borderColor = "#16a34a"; // green-600
        hint.textContent = "✓ Формат верный";
        hint.style.color = "#16a34a";
      } else {
        phone.style.borderColor = "#dc2626"; // red-600
        hint.textContent = "Нужен формат: +7 911 862 79 57 (или 8 911...)";
        hint.style.color = "#dc2626";
      }
    }

    phone.addEventListener("input", (e) => {
      const t = e.target;
      const cleaned = clean(t.value);
      if (cleaned !== t.value) t.value = cleaned;
      update();
    });

    phone.addEventListener("paste", (e) => {
      e.preventDefault();
      const text = (e.clipboardData || window.clipboardData).getData("text");
      const cleaned = clean(text);
      const start = phone.selectionStart || 0;
      const end = phone.selectionEnd || 0;
      phone.value = phone.value.slice(0, start) + cleaned + phone.value.slice(end);
      phone.selectionStart = phone.selectionEnd = start + cleaned.length;
      update();
    });

    phone.addEventListener("blur", update);

    // Блокировка submit на JS-уровне как страховка к pattern.
    const form = phone.closest("form");
    if (form) {
      form.addEventListener("submit", (e) => {
        const v = phone.value.trim();
        if (!PHONE_RE.test(v)) {
          e.preventDefault();
          update();
          phone.focus();
          phone.scrollIntoView({ behavior: "smooth", block: "center" });
        }
      });
    }
  })();
</script>
