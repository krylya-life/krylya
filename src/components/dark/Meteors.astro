---
/*
 * Meteors — падающие звёзды на тёмном фоне. Vanilla-вариант:
 * случайные позиции/задержки определяются на этапе сборки (статика),
 * вся анимация — чистый CSS (.animate-meteor из dark.css).
 *
 * Использование (родитель должен иметь position: relative + overflow-hidden):
 *   <Meteors number={14} />
 */
interface Props {
  number?: number;
}
const { number = 20 } = Astro.props;

const meteors = Array.from({ length: number }, () => ({
  left: Math.floor(Math.random() * (400 - -400) + -400) + "px",
  delay: (Math.random() * (0.8 - 0.2) + 0.2).toFixed(2) + "s",
  duration: Math.floor(Math.random() * (10 - 2) + 2) + "s",
}));
---
{meteors.map((m) => (
  <span
    class="pointer-events-none absolute top-1/2 left-1/2 h-0.5 w-0.5 rotate-[215deg] animate-meteor rounded-[9999px] bg-slate-500 shadow-[0_0_0_1px_#ffffff10]"
    style={`top: 0; left: ${m.left}; animation-delay: ${m.delay}; animation-duration: ${m.duration};`}
  >
    <span class="pointer-events-none absolute top-1/2 -z-10 h-px w-[50px] -translate-y-1/2 bg-gradient-to-r from-slate-500 to-transparent"></span>
  </span>
))}
