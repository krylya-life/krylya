---
import DarkLayout from "../layouts/DarkLayout.astro";
import Seo from "../components/Seo.astro";
import JsonLdGraph from "../components/JsonLdGraph.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import MetrikaCounter from "../components/MetrikaCounter.astro";
import { business } from "../config/business.ts";

const seoTitle = "Контакты — ивент-агентство Крылья, Калининград";
const seoDescription =
  "Свяжитесь с агентством Крылья: телефон, Telegram, email. Организация мероприятий в Калининграде и области. ИП Вострикова Мария Валерьевна, ИНН 550209075500.";

const crumbs = [
  { label: "Главная", href: "/" },
  { label: "Контакты", href: "/contacts/" },
];

const telegramHandle = business.telegramPersonal.replace("@", "");
---

<DarkLayout title={seoTitle} description={seoDescription} noindex>
  <Seo
    slot="seo"
    title={seoTitle}
    description={seoDescription}
    pathname="/contacts/"
  />
  <JsonLdGraph slot="seo" />

  <!-- Hero -->
  <section class="relative overflow-hidden px-6 pt-32 pb-14 md:px-12 md:pt-40 md:pb-20">
    <div class="lab-aurora pointer-events-none"></div>
    <div class="relative mx-auto max-w-6xl">
      <Breadcrumbs crumbs={crumbs} />
      <h1 class="mt-6 text-4xl font-semibold tracking-tight text-white md:text-6xl">
        Контакты
      </h1>
      <span class="mt-4 inline-block h-1 w-12 bg-[#FFF200]"></span>
      <p class="mt-8 text-lg leading-relaxed text-white/75 md:text-xl">
        Позвоните, напишите в&nbsp;Telegram или на&nbsp;почту — обычно отвечаем
        в&nbsp;течение&nbsp;рабочего&nbsp;дня. На&nbsp;этапе брифа разбираем формат,
        бюджет и&nbsp;ограничения; решение по&nbsp;концепции и&nbsp;смете присылаем
        за&nbsp;3–5 рабочих дней.
      </p>
    </div>
  </section>

  <div class="lab-divider-glow mx-auto max-w-6xl"></div>

  <!-- Основные каналы связи -->
  <section
    class="relative px-6 py-14 md:px-12 md:py-20"
    itemscope
    itemtype="https://schema.org/Organization"
  >
    <meta itemprop="name" content={business.name} />
    <meta itemprop="legalName" content={business.legalName} />
    <meta itemprop="taxID" content={business.taxId} />
    <meta itemprop="vatID" content={business.ogrnip} />
    <meta itemprop="url" content={business.urlCyrillic} />

    <div class="mx-auto max-w-6xl">
      <h2 class="text-3xl font-semibold tracking-tight text-white md:text-5xl">
        Связь
      </h2>
      <span class="mt-4 inline-block h-1 w-12 bg-[#FFF200]"></span>

      <div class="mt-10 grid gap-5 md:grid-cols-2">
        <a
          href={`tel:${business.phone}`}
          class="group flex flex-col gap-3 rounded-2xl border border-white/10 bg-white/[0.03] p-8 no-underline transition-colors hover:border-[#FFF200]/40"
        >
          <span class="text-xs font-semibold uppercase tracking-[0.25em] text-[#FFF200]">
            Телефон
          </span>
          <span
            class="text-2xl font-semibold text-white md:text-3xl"
            itemprop="telephone"
          >{business.phoneDisplay}</span>
          <span class="text-sm text-white/55">
            с&nbsp;9:00 до&nbsp;21:00, ежедневно
          </span>
        </a>

        <a
          href={`https://t.me/${telegramHandle}`}
          target="_blank"
          rel="noopener noreferrer"
          class="group flex flex-col gap-3 rounded-2xl border border-white/10 bg-white/[0.03] p-8 no-underline transition-colors hover:border-[#FFF200]/40"
        >
          <span class="text-xs font-semibold uppercase tracking-[0.25em] text-[#FFF200]">
            Telegram
          </span>
          <span class="text-2xl font-semibold text-white md:text-3xl">
            {business.telegramPersonal}
          </span>
          <span class="text-sm text-white/55">
            обычно отвечаем в&nbsp;течение часа
          </span>
        </a>
      </div>

      <a
        href={`mailto:${business.email}`}
        class="mt-5 flex flex-wrap items-center gap-3 rounded-2xl border border-white/10 bg-white/[0.02] p-6 no-underline transition-colors hover:border-[#FFF200]/30"
      >
        <span class="text-xs font-semibold uppercase tracking-[0.25em] text-[#FFF200]">
          Email
        </span>
        <span class="text-lg text-white" itemprop="email">{business.email}</span>
      </a>
    </div>
  </section>

  <div class="lab-divider-glow mx-auto max-w-6xl"></div>

  <!-- Регион + реквизиты -->
  <section class="lab-bg-alt relative px-6 py-14 md:px-12 md:py-20">
    <div class="mx-auto max-w-6xl">
      <div class="grid gap-12 md:grid-cols-2">
        <div
          itemscope
          itemtype="https://schema.org/PostalAddress"
        >
          <h2 class="text-xs font-semibold uppercase tracking-[0.25em] text-[#FFF200]">
            Где работаем
          </h2>
          <p class="mt-4 text-2xl font-semibold text-white md:text-3xl">
            <span itemprop="addressLocality">{business.locality}</span>
          </p>
          <p class="mt-2 text-white/65" itemprop="addressRegion">
            {business.region}
          </p>
          <meta itemprop="addressCountry" content={business.countryCode} />
          <p class="mt-6 text-white/65 leading-relaxed">
            Калининград и&nbsp;область — единственный регион работы.
            От&nbsp;центра города до&nbsp;побережья и&nbsp;замков
            в&nbsp;области.
          </p>
          <p class="mt-4 text-white/55 text-sm leading-relaxed">
            Если вы&nbsp;иногородний клиент и&nbsp;хотите провести мероприятие
            в&nbsp;Калининграде — мы&nbsp;помогаем с&nbsp;площадками, логистикой
            и&nbsp;местными подрядчиками. Личная встреча возможна по&nbsp;записи.
          </p>
        </div>

        <div>
          <h2 class="text-xs font-semibold uppercase tracking-[0.25em] text-[#FFF200]">
            Реквизиты
          </h2>
          <div class="mt-4 space-y-2 text-white/80">
            <p>{business.legalName}</p>
            <p>ИНН&nbsp;{business.taxId}</p>
            <p>ОГРНИП&nbsp;{business.ogrnip}</p>
          </div>
          <p class="mt-6 text-sm text-white/55">
            <a
              href="/privacy/"
              class="underline decoration-[#FFF200]/40 underline-offset-4 hover:decoration-[#FFF200]"
            >
              Политика обработки персональных данных
            </a>
          </p>
        </div>
      </div>
    </div>
  </section>

  <MetrikaCounter slot="analytics" />
</DarkLayout>
