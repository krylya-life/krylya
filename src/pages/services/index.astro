---
import { getCollection } from "astro:content";
import DarkLayout from "../../layouts/DarkLayout.astro";
import Seo from "../../components/Seo.astro";
import JsonLdGraph from "../../components/JsonLdGraph.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import MetrikaCounter from "../../components/MetrikaCounter.astro";
import PricingTeaser from "../../components/blocks/PricingTeaser.astro";
import ContactBlock from "../../components/blocks/ContactBlock.astro";
import MagicCard from "../../components/dark/MagicCard.astro";

const all = await getCollection("services");
const services = all.sort((a, b) => a.data.order - b.data.order);

const seoTitle = "Услуги — организация мероприятий в Калининграде";
const seoDescription =
  "Организация мероприятий в Калининграде и области: корпоративы, деловые и клиентские события, тимбилдинги, координация дня, частные торжества.";

const crumbs = [
  { label: "Главная", href: "/" },
  { label: "Услуги", href: "/services/" },
];
---

<DarkLayout title={seoTitle} description={seoDescription}>
  <Seo
    slot="seo"
    title={seoTitle}
    description={seoDescription}
    pathname="/services/"
  />
  <JsonLdGraph slot="seo" />

  <!-- Hero-секция страницы -->
  <section class="relative overflow-hidden px-6 pt-32 pb-14 md:px-12 md:pt-40 md:pb-20">
    <div class="lab-aurora pointer-events-none"></div>
    <div class="relative mx-auto max-w-6xl">
      <Breadcrumbs crumbs={crumbs} />
      <h1 class="mt-6 text-4xl font-semibold tracking-tight text-white md:text-6xl">
        Чем мы&nbsp;занимаемся
      </h1>
      <span class="mt-4 inline-block h-1 w-12 bg-[#FFF200]"></span>
      <p class="mt-6 max-w-3xl text-white/65 md:text-lg leading-relaxed">
        Организуем корпоративные и&nbsp;частные мероприятия в&nbsp;Калининграде
        и&nbsp;области — от&nbsp;первого брифа до&nbsp;отчёта после события.
        Концепция, площадка, подрядчики, программа, координация в&nbsp;день&nbsp;Х —
        единая команда вместо разрозненных контактов и&nbsp;одна точка
        ответственности.
      </p>
    </div>
  </section>

  <div class="lab-divider-glow mx-auto max-w-6xl"></div>

  <!-- 6 услуг сеткой 2×3 -->
  <section class="relative px-6 py-14 md:px-12 md:py-20">
    <div class="mx-auto max-w-6xl">
      {services.length > 0 ? (
        <div class="grid gap-5 md:grid-cols-2 lg:grid-cols-3">
          {services.map((service) => (
            <MagicCard
              href={`/services/${service.data.slug}/`}
              class="flex min-h-[220px] flex-col justify-between p-6"
            >
              <div>
                <h2 class="text-xl font-semibold text-white">
                  {service.data.title}
                </h2>
                <p class="mt-3 text-sm leading-relaxed text-white/60">
                  {service.data.description}
                </p>
              </div>
              <span class="mt-6 inline-flex items-center gap-2 text-sm font-medium text-[#FFF200]">
                Подробнее
                <span class="inline-block h-px w-6 bg-[#FFF200] transition-all group-hover:w-10"></span>
              </span>
            </MagicCard>
          ))}
        </div>
      ) : (
        <p class="text-white/60 italic">Услуги появятся в&nbsp;Phase 4.</p>
      )}
    </div>
  </section>

  <div class="lab-divider-glow mx-auto max-w-6xl"></div>

  <!-- Текстовый блок: как выбрать услугу и как устроена работа -->
  <section class="relative px-6 py-14 md:px-12 md:py-20">
    <div class="mx-auto max-w-6xl">
     <div class="max-w-3xl">
      <h2 class="text-2xl font-semibold tracking-tight text-white md:text-3xl">
        Как понять, какая услуга нужна
      </h2>
      <span class="mt-4 inline-block h-1 w-12 bg-[#FFF200]"></span>
      <p class="mt-6 text-base leading-relaxed text-white/65 md:text-lg">
        Названия услуг — это про&nbsp;повод и&nbsp;аудиторию, а&nbsp;не&nbsp;про&nbsp;размер
        бюджета. Чаще всего заказчик приходит с&nbsp;задачей вроде «нужно собрать
        людей в&nbsp;декабре» — и&nbsp;формат мы&nbsp;определяем вместе на&nbsp;первом
        разговоре. Ориентир такой:
      </p>
      <ul class="mt-6 space-y-4 text-base leading-relaxed text-white/65 md:text-lg">
        <li>
          <strong class="text-white">Событие для&nbsp;своей команды</strong> — новогодний
          вечер, юбилей компании, отраслевой праздник:
          <a href="/services/corporate-parties/" class="text-[#FFF200] underline-offset-4 hover:underline">организация корпоративов</a>.
        </li>
        <li>
          <strong class="text-white">Событие для&nbsp;партнёров и&nbsp;покупателей</strong> —
          партнёрский вечер, программа лояльности, праздник для&nbsp;жителей дома:
          <a href="/services/client-events/" class="text-[#FFF200] underline-offset-4 hover:underline">клиентские мероприятия</a>.
        </li>
        <li>
          <strong class="text-white">Событие с&nbsp;деловой повесткой</strong> — конференция,
          презентация продукта, открытие объекта, пресс-мероприятие:
          <a href="/services/business-events/" class="text-[#FFF200] underline-offset-4 hover:underline">деловые мероприятия</a>.
        </li>
        <li>
          <strong class="text-white">Событие, где главное — команда</strong> — выездной
          ретрит, командная игра, программа на&nbsp;побережье:
          <a href="/services/teambuilding/" class="text-[#FFF200] underline-offset-4 hover:underline">тимбилдинги</a>.
        </li>
        <li>
          <strong class="text-white">Личный повод</strong> — юбилей, день рождения,
          семейное торжество:
          <a href="/services/private/" class="text-[#FFF200] underline-offset-4 hover:underline">частные мероприятия</a>.
        </li>
        <li>
          <strong class="text-white">Всё уже собрано, нужны руки на&nbsp;площадке</strong> —
          подрядчики найдены, сценарий готов, но&nbsp;в&nbsp;день события нужен тот, кто
          сведёт это в&nbsp;один тайминг:
          <a href="/services/coordination/" class="text-[#FFF200] underline-offset-4 hover:underline">координация дня</a>.
        </li>
      </ul>

      <h2 class="mt-14 text-2xl font-semibold tracking-tight text-white md:text-3xl">
        Как устроена работа
      </h2>
      <span class="mt-4 inline-block h-1 w-12 bg-[#FFF200]"></span>
      <p class="mt-6 text-base leading-relaxed text-white/65 md:text-lg">
        Схема одинаковая для&nbsp;всех услуг — меняются только масштаб и&nbsp;сроки.
        Начинаем с&nbsp;разговора о&nbsp;задаче: кто гости, какой повод, что должно
        остаться в&nbsp;памяти и&nbsp;в&nbsp;какие деньги вы&nbsp;рассчитываете уложиться.
        Дальше — концепция и&nbsp;смета, в&nbsp;которой видно, за&nbsp;что вы&nbsp;платите:
        площадка, подрядчики, декор, техника, программа отдельными строками.
      </p>
      <p class="mt-4 text-base leading-relaxed text-white/65 md:text-lg">
        После согласования мы&nbsp;берём на&nbsp;себя всю подготовку — бронь площадки,
        договоры с&nbsp;подрядчиками, декор, тайминг, репетиции. В&nbsp;день события
        на&nbsp;площадке работает наша команда: заказчику остаётся быть гостем
        собственного праздника. После — отчёт и&nbsp;материалы фотографа.
      </p>
      <p class="mt-4 text-base leading-relaxed text-white/65 md:text-lg">
        Сроки зависят от&nbsp;формата: камерный вечер на&nbsp;30–60 человек реально
        собрать за&nbsp;3–4&nbsp;недели, событие на&nbsp;100–200 гостей требует
        полутора-двух месяцев, крупные форматы и&nbsp;высокий сезон — от&nbsp;трёх.
        Новогодние площадки в&nbsp;Калининграде разбирают ещё&nbsp;летом.
      </p>

      <h2 class="mt-14 text-2xl font-semibold tracking-tight text-white md:text-3xl">
        Если вы&nbsp;не&nbsp;в&nbsp;Калининграде
      </h2>
      <span class="mt-4 inline-block h-1 w-12 bg-[#FFF200]"></span>
      <p class="mt-6 text-base leading-relaxed text-white/65 md:text-lg">
        Значительная часть наших заказчиков ведёт проект удалённо — из&nbsp;Москвы,
        Петербурга или&nbsp;другого города. Для&nbsp;такой работы важны две вещи:
        честная картинка площадок до&nbsp;подписания договора и&nbsp;один человек,
        с&nbsp;которым вы&nbsp;общаетесь по&nbsp;всем вопросам.
      </p>
      <p class="mt-4 text-base leading-relaxed text-white/65 md:text-lg">
        Мы&nbsp;снимаем видео с&nbsp;площадок и&nbsp;показываем их&nbsp;до&nbsp;выбора,
        собираем смету в&nbsp;одном документе, держим связь в&nbsp;удобном мессенджере
        и&nbsp;в&nbsp;день события ведём онлайн-репортаж для&nbsp;тех, кто не&nbsp;смог
        приехать. Как это выглядит на&nbsp;практике — в&nbsp;подробном материале
        <a href="/идеи/korporativ-iz-drugogo-goroda/" class="text-[#FFF200] underline-offset-4 hover:underline">про&nbsp;корпоратив из&nbsp;другого города</a>,
        а&nbsp;результат — в&nbsp;разделе <a href="/cases/" class="text-[#FFF200] underline-offset-4 hover:underline">кейсов</a>.
      </p>
     </div>
    </div>
  </section>

  <div class="lab-divider-glow mx-auto max-w-6xl"></div>

  <PricingTeaser />

  <div class="lab-divider-glow mx-auto max-w-6xl"></div>

  <ContactBlock />

  <MetrikaCounter slot="analytics" />
</DarkLayout>
