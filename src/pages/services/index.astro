---
import { getCollection } from "astro:content";
import DarkLayout from "../../layouts/DarkLayout.astro";
import Seo from "../../components/Seo.astro";
import JsonLdGraph from "../../components/JsonLdGraph.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import MetrikaCounter from "../../components/MetrikaCounter.astro";
import PricingTeaser from "../../components/blocks/PricingTeaser.astro";
import ContactBlock from "../../components/blocks/ContactBlock.astro";
import MagicCard from "../../components/dark/MagicCard.astro";

const all = await getCollection("services");
const services = all.sort((a, b) => a.data.order - b.data.order);

const seoTitle = "Услуги — организация мероприятий в Калининграде";
const seoDescription =
  "Организация корпоративных и частных мероприятий в Калининграде и области: корпоративы, деловые события, клиентские мероприятия, тимбилдинги, координация дня, частные торжества. От концепции до сопровождения в день события.";

const crumbs = [
  { label: "Главная", href: "/" },
  { label: "Услуги", href: "/services/" },
];
---

<DarkLayout title={seoTitle} description={seoDescription} noindex>
  <Seo
    slot="seo"
    title={seoTitle}
    description={seoDescription}
    pathname="/services/"
  />
  <JsonLdGraph slot="seo" />

  <!-- Hero-секция страницы -->
  <section class="relative overflow-hidden px-6 pt-32 pb-14 md:px-12 md:pt-40 md:pb-20">
    <div class="lab-aurora pointer-events-none"></div>
    <div class="relative mx-auto max-w-6xl">
      <Breadcrumbs crumbs={crumbs} />
      <h1 class="mt-6 text-4xl font-semibold tracking-tight text-white md:text-6xl">
        Чем мы&nbsp;занимаемся
      </h1>
      <span class="mt-4 inline-block h-1 w-12 bg-[#FFF200]"></span>
      <p class="mt-6 max-w-3xl text-white/65 md:text-lg leading-relaxed">
        Организуем корпоративные и&nbsp;частные мероприятия в&nbsp;Калининграде
        и&nbsp;области — от&nbsp;первого брифа до&nbsp;отчёта после события.
        Концепция, площадка, подрядчики, программа, координация в&nbsp;день&nbsp;Х —
        единая команда вместо разрозненных контактов и&nbsp;одна точка
        ответственности.
      </p>
    </div>
  </section>

  <div class="lab-divider-glow mx-auto max-w-6xl"></div>

  <!-- 6 услуг сеткой 2×3 -->
  <section class="relative px-6 py-14 md:px-12 md:py-20">
    <div class="mx-auto max-w-6xl">
      {services.length > 0 ? (
        <div class="grid gap-5 md:grid-cols-2 lg:grid-cols-3">
          {services.map((service) => (
            <MagicCard
              href={`/services/${service.data.slug}/`}
              class="flex min-h-[220px] flex-col justify-between p-6"
            >
              <div>
                <h2 class="text-xl font-semibold text-white">
                  {service.data.title}
                </h2>
                <p class="mt-3 text-sm leading-relaxed text-white/60">
                  {service.data.description}
                </p>
              </div>
              <span class="mt-6 inline-flex items-center gap-2 text-sm font-medium text-[#FFF200]">
                Подробнее
                <span class="inline-block h-px w-6 bg-[#FFF200] transition-all group-hover:w-10"></span>
              </span>
            </MagicCard>
          ))}
        </div>
      ) : (
        <p class="text-white/60 italic">Услуги появятся в&nbsp;Phase 4.</p>
      )}
    </div>
  </section>

  <div class="lab-divider-glow mx-auto max-w-6xl"></div>

  <PricingTeaser />

  <div class="lab-divider-glow mx-auto max-w-6xl"></div>

  <ContactBlock />

  <MetrikaCounter slot="analytics" />
</DarkLayout>
