---
import { getCollection, render } from "astro:content";
import DarkLayout from "../../layouts/DarkLayout.astro";
import Seo from "../../components/Seo.astro";
import JsonLdGraph from "../../components/JsonLdGraph.astro";
import JsonLdService from "../../components/JsonLdService.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import MetrikaCounter from "../../components/MetrikaCounter.astro";
import PricingTeaser from "../../components/blocks/PricingTeaser.astro";
import ContactBlock from "../../components/blocks/ContactBlock.astro";

export async function getStaticPaths() {
  const services = await getCollection("services");
  return services.map((service) => ({
    params: { slug: service.id },
    props: { service },
  }));
}

const { service } = Astro.props;
const { Content } = await render(service);
const { title, description, slug } = service.data;

// SEO title — добавляем «в Калининграде» и стоимостный/SEO якорь
const seoTitle = `${title} в Калининграде — под ключ от агентства Крылья`;
const seoDescription = description;

const crumbs = [
  { label: "Главная", href: "/" },
  { label: "Услуги", href: "/services/" },
  { label: title, href: `/services/${slug}/` },
];
---

<DarkLayout title={seoTitle} description={seoDescription} noindex>
  <Seo
    slot="seo"
    title={seoTitle}
    description={seoDescription}
    pathname={`/services/${slug}/`}
  />
  <JsonLdGraph slot="seo" />
  <JsonLdService
    slot="seo"
    slug={slug}
    name={title}
    description={description}
    serviceType={title}
  />

  <!-- Hero подстраницы -->
  <section class="relative overflow-hidden px-6 pt-32 pb-14 md:px-12 md:pt-40 md:pb-20">
    <div class="lab-aurora pointer-events-none"></div>
    <div class="relative mx-auto max-w-4xl">
      <Breadcrumbs crumbs={crumbs} />
      <h1 class="mt-6 text-4xl font-semibold tracking-tight text-white md:text-6xl">
        {title}
      </h1>
      <span class="mt-4 inline-block h-1 w-12 bg-[#FFF200]"></span>
      <p class="mt-6 text-white/70 md:text-lg leading-relaxed">
        {description}
      </p>
    </div>
  </section>

  <div class="lab-divider-glow mx-auto max-w-4xl"></div>

  <!-- MDX-контент с тёмной типографикой -->
  <section class="relative px-6 py-14 md:px-12 md:py-20">
    <article
      class="mx-auto max-w-3xl text-white/80 leading-relaxed
        [&_h1]:hidden
        [&_h2]:mt-12 [&_h2]:text-2xl [&_h2]:font-semibold [&_h2]:text-white [&_h2]:tracking-tight md:[&_h2]:text-3xl
        [&_h3]:mt-8 [&_h3]:text-xl [&_h3]:font-semibold [&_h3]:text-white
        [&_p]:mt-5 [&_p]:leading-relaxed md:[&_p]:text-lg
        [&_ul]:mt-5 [&_ul]:space-y-2
        [&_ul>li]:relative [&_ul>li]:pl-5
        [&_ul>li]:before:absolute [&_ul>li]:before:left-0 [&_ul>li]:before:top-3 [&_ul>li]:before:h-1.5 [&_ul>li]:before:w-1.5 [&_ul>li]:before:rounded-full [&_ul>li]:before:bg-[#FFF200]
        [&_ol]:mt-5 [&_ol]:space-y-2 [&_ol]:list-decimal [&_ol]:pl-6 [&_ol]:marker:text-[#FFF200] [&_ol]:marker:font-semibold
        [&_strong]:text-white
        [&_a]:text-[#FFF200] [&_a]:underline [&_a]:underline-offset-4 [&_a]:decoration-[#FFF200]/40 hover:[&_a]:decoration-[#FFF200]
        [&_blockquote]:mt-6 [&_blockquote]:border-l-2 [&_blockquote]:border-[#FFF200] [&_blockquote]:pl-5 [&_blockquote]:italic [&_blockquote]:text-white/75"
    >
      <Content />
    </article>
  </section>

  {slug !== "coordination" && (
    <>
      <div class="lab-divider-glow mx-auto max-w-6xl"></div>
      <PricingTeaser />
    </>
  )}

  <div class="lab-divider-glow mx-auto max-w-6xl"></div>

  <ContactBlock />

  <MetrikaCounter slot="analytics" />
</DarkLayout>
