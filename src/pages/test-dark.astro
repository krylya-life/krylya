---
/*
 * Smoke-тест DarkLayout и компонентов из src/components/dark/.
 * Страница временная, помечена noindex. Используется для ревью Маши
 * перед переносом стилей на главную и остальные страницы.
 */
import DarkLayout from "../layouts/DarkLayout.astro";
import Spotlight from "../components/dark/Spotlight.astro";
import Meteors from "../components/dark/Meteors.astro";
import BorderBeam from "../components/dark/BorderBeam.astro";
import MagicCard from "../components/dark/MagicCard.astro";
import KaliningradSilhouette from "../components/dark/KaliningradSilhouette.astro";
---

<DarkLayout title="Test Dark — Крылья" noindex>
  <section class="relative min-h-[60vh] overflow-hidden px-6 py-20 md:px-12">
    <Spotlight class="-top-40 left-0" fill="#FFF200" />
    <div class="lab-aurora pointer-events-none"></div>
    <div class="pointer-events-none absolute inset-0 overflow-hidden">
      <Meteors number={10} />
    </div>
    <div class="relative mx-auto max-w-6xl">
      <h1 class="text-4xl font-semibold text-white md:text-6xl">
        Test Dark Layout
      </h1>
      <p class="mt-4 max-w-2xl text-base text-white/65 md:text-lg">
        Проверка, что все эффекты тёмной темы работают на vanilla Astro+CSS,
        без React. Если видишь падающие метеоры, мерцающую линию-разделитель
        и жёлтый глоу под курсором на карточках — фундамент готов.
      </p>

      <div class="mt-10 grid gap-5 md:grid-cols-3">
        <MagicCard class="p-6">
          <h3 class="text-lg font-semibold text-white">Магическая карточка</h3>
          <p class="mt-2 text-sm text-white/65">Наведи курсор — должно быть жёлтое свечение.</p>
        </MagicCard>
        <MagicCard class="p-6">
          <h3 class="text-lg font-semibold text-white">Вторая</h3>
          <p class="mt-2 text-sm text-white/65">Каждая карточка ловит курсор независимо.</p>
        </MagicCard>
        <MagicCard class="p-6" href="/contacts/">
          <h3 class="text-lg font-semibold text-white">Третья (ссылка)</h3>
          <p class="mt-2 text-sm text-white/65">Эта карточка — &lt;a&gt; на /contacts/.</p>
        </MagicCard>
      </div>

      <div class="relative mt-10 overflow-hidden rounded-2xl border border-white/10 bg-white/[0.02] p-6">
        <BorderBeam duration={14} colorFrom="#FFF200" colorTo="#FFA500" />
        <p class="text-white">BorderBeam должен бегать по периметру этого блока.</p>
      </div>
    </div>
  </section>

  <div class="lab-divider-glow mx-auto max-w-6xl"></div>

  <section class="lab-bg-feature relative overflow-hidden px-6 py-20 md:px-12">
    <KaliningradSilhouette />
    <div class="relative mx-auto max-w-6xl">
      <h2 class="text-3xl font-semibold text-white md:text-5xl">
        Силуэт города
      </h2>
      <span class="mt-4 inline-block h-1 w-12 bg-[#FFF200]"></span>
      <p class="mt-6 max-w-2xl text-base text-white/65">
        Внизу секции — линейная графика Калининграда жёлтым. На мобиле
        силуэт скрыт (md:block), чтобы не отвлекать.
      </p>
    </div>
  </section>
</DarkLayout>
