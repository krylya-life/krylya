---
import DarkLayout from "../layouts/DarkLayout.astro";
import Seo from "../components/Seo.astro";
import JsonLdGraph from "../components/JsonLdGraph.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import MetrikaCounter from "../components/MetrikaCounter.astro";
import ContactBlock from "../components/blocks/ContactBlock.astro";

const seoTitle = "Сколько стоит организовать мероприятие в Калининграде — цены агентства Крылья";
const seoDescription =
  "Из чего складывается смета мероприятия в Калининграде, что входит в наши 10% за организационные услуги и какие бывают типичные диапазоны бюджетов.";

const crumbs = [
  { label: "Главная", href: "/" },
  { label: "Сколько стоит", href: "/pricing/" },
];
---

<DarkLayout title={seoTitle} description={seoDescription}>
  <Seo
    slot="seo"
    title={seoTitle}
    description={seoDescription}
    pathname="/pricing/"
  />
  <JsonLdGraph slot="seo" />

  <!-- Hero-секция -->
  <section class="relative overflow-hidden px-6 pt-32 pb-14 md:px-12 md:pt-40 md:pb-20">
    <div class="lab-aurora pointer-events-none"></div>
    <div class="relative mx-auto max-w-4xl">
      <Breadcrumbs crumbs={crumbs} />
      <h1 class="mt-6 text-4xl font-semibold tracking-tight text-white md:text-6xl">
        Сколько стоит организовать мероприятие в&nbsp;Калининграде
      </h1>
      <span class="mt-4 inline-block h-1 w-12 bg-[#FFF200]"></span>
      <p class="mt-6 text-white/70 md:text-lg leading-relaxed">
        Подрядчики идут в&nbsp;смете отдельной строкой по&nbsp;их&nbsp;реальной стоимости.
        Наши&nbsp;10%&nbsp;— плата за&nbsp;организационные услуги: концепцию, поиск площадки
        и&nbsp;подрядчиков, бюджет. Ниже&nbsp;— из&nbsp;чего складывается смета и&nbsp;какие
        бывают типичные диапазоны бюджетов.
      </p>
    </div>
  </section>

  <div class="lab-divider-glow mx-auto max-w-4xl"></div>

  <!-- Контент про смету и 10%-модель -->
  <section class="relative px-6 py-14 md:px-12 md:py-20">
    <div class="mx-auto max-w-4xl space-y-10">

      <div class="rounded-2xl border border-white/10 bg-white/[0.03] p-6 md:p-8">
        <h2 class="text-2xl font-semibold text-white md:text-3xl">
          Из&nbsp;чего складывается смета мероприятия
        </h2>
        <p class="mt-4 text-white/70 leading-relaxed md:text-lg">
          Сметы мероприятий складываются из&nbsp;нескольких типовых статей расходов.
          У&nbsp;разных событий пропорции отличаются, но&nbsp;состав в&nbsp;большинстве случаев
          один и&nbsp;тот&nbsp;же:
        </p>
        <ul class="mt-5 space-y-3 text-white/70 leading-relaxed">
          <li class="relative pl-5 before:absolute before:left-0 before:top-3 before:h-1.5 before:w-1.5 before:rounded-full before:bg-[#FFF200]">
            <strong class="text-white">Площадка</strong>&nbsp;— аренда зала, площадки,
            исторического объекта, ресторана, выездной локации. Часто включает в&nbsp;себя
            базовый кейтеринг или&nbsp;ограничение по&nbsp;поставщику
          </li>
          <li class="relative pl-5 before:absolute before:left-0 before:top-3 before:h-1.5 before:w-1.5 before:rounded-full before:bg-[#FFF200]">
            <strong class="text-white">Кейтеринг</strong>&nbsp;— еда и&nbsp;напитки.
            Может быть от&nbsp;площадки или&nbsp;от&nbsp;отдельного подрядчика
          </li>
          <li class="relative pl-5 before:absolute before:left-0 before:top-3 before:h-1.5 before:w-1.5 before:rounded-full before:bg-[#FFF200]">
            <strong class="text-white">Декор и&nbsp;флористика</strong>&nbsp;— оформление
            пространства, навигация, подарочные элементы
          </li>
          <li class="relative pl-5 before:absolute before:left-0 before:top-3 before:h-1.5 before:w-1.5 before:rounded-full before:bg-[#FFF200]">
            <strong class="text-white">Техника</strong>&nbsp;— звук, свет, экраны,
            проекция, стрим, перевод
          </li>
          <li class="relative pl-5 before:absolute before:left-0 before:top-3 before:h-1.5 before:w-1.5 before:rounded-full before:bg-[#FFF200]">
            <strong class="text-white">Ведущий, артисты, программа</strong>&nbsp;— зависит
            от&nbsp;формата события
          </li>
          <li class="relative pl-5 before:absolute before:left-0 before:top-3 before:h-1.5 before:w-1.5 before:rounded-full before:bg-[#FFF200]">
            <strong class="text-white">Фото и&nbsp;видео</strong>&nbsp;— съёмка, монтаж
            итогового материала
          </li>
          <li class="relative pl-5 before:absolute before:left-0 before:top-3 before:h-1.5 before:w-1.5 before:rounded-full before:bg-[#FFF200]">
            <strong class="text-white">Логистика</strong>&nbsp;— трансферы, доставки,
            монтаж и&nbsp;демонтаж, проживание (для&nbsp;выездных форматов)
          </li>
          <li class="relative pl-5 before:absolute before:left-0 before:top-3 before:h-1.5 before:w-1.5 before:rounded-full before:bg-[#FFF200]">
            <strong class="text-white">Координация в&nbsp;день</strong>&nbsp;— наша команда
            на&nbsp;площадке: контроль программы, подрядчиков, нештатных ситуаций
          </li>
        </ul>
        <p class="mt-5 text-white/70 leading-relaxed md:text-lg">
          Все эти строки видны вам в&nbsp;смете до&nbsp;старта работы.
        </p>
      </div>

      <div class="rounded-2xl border border-[#FFF200]/30 bg-[#FFF200]/[0.04] p-6 md:p-8">
        <h2 class="text-2xl font-semibold text-white md:text-3xl">
          Что входит в&nbsp;наши 10% за&nbsp;организационные услуги
        </h2>
        <p class="mt-4 text-white/70 leading-relaxed md:text-lg">
          10% от&nbsp;общей сметы&nbsp;— плата за&nbsp;организационную работу.
          Что в&nbsp;это входит:
        </p>
        <ul class="mt-5 space-y-3 text-white/75 leading-relaxed">
          <li class="relative pl-5 before:absolute before:left-0 before:top-3 before:h-1.5 before:w-1.5 before:rounded-full before:bg-[#FFF200]">
            концепция и&nbsp;стилистика мероприятия, визуальный язык и&nbsp;полиграфия
            (пригласительные, меню, навигация);
          </li>
          <li class="relative pl-5 before:absolute before:left-0 before:top-3 before:h-1.5 before:w-1.5 before:rounded-full before:bg-[#FFF200]">
            проработка меню и&nbsp;алкогольной карты;
          </li>
          <li class="relative pl-5 before:absolute before:left-0 before:top-3 before:h-1.5 before:w-1.5 before:rounded-full before:bg-[#FFF200]">
            подбор площадки и&nbsp;всех подрядчиков&nbsp;— ведущий, фото и&nbsp;видео,
            декор и&nbsp;флористика, техника, шоу-программа, фейерверк;
          </li>
          <li class="relative pl-5 before:absolute before:left-0 before:top-3 before:h-1.5 before:w-1.5 before:rounded-full before:bg-[#FFF200]">
            бюджетирование и&nbsp;переговоры с&nbsp;подрядчиками от&nbsp;первого брифа
            до&nbsp;закрывающих документов;
          </li>
          <li class="relative pl-5 before:absolute before:left-0 before:top-3 before:h-1.5 before:w-1.5 before:rounded-full before:bg-[#FFF200]">
            сценарный тайминг мероприятия и&nbsp;технический тайминг для&nbsp;подрядчиков
            (монтаж, демонтаж, прибытие артистов, гримёрки, бытовые райдеры);
          </li>
          <li class="relative pl-5 before:absolute before:left-0 before:top-3 before:h-1.5 before:w-1.5 before:rounded-full before:bg-[#FFF200]">
            трансфер и&nbsp;размещение гостей и&nbsp;артистов;
          </li>
          <li class="relative pl-5 before:absolute before:left-0 before:top-3 before:h-1.5 before:w-1.5 before:rounded-full before:bg-[#FFF200]">
            координация подготовки и&nbsp;команда на&nbsp;площадке в&nbsp;день
            мероприятия&nbsp;— единая точка контакта на&nbsp;протяжении всего проекта.
          </li>
        </ul>
      </div>

      <div class="rounded-2xl border border-white/10 bg-white/[0.03] p-6 md:p-8">
        <h2 class="text-2xl font-semibold text-white md:text-3xl">
          Типичные диапазоны бюджетов
        </h2>
        <p class="mt-4 text-white/70 leading-relaxed md:text-lg">
          Бюджеты наших клиентов сильно различаются от&nbsp;формата к&nbsp;формату.
          Чтобы дать ориентир&nbsp;— несколько типичных диапазонов:
        </p>
        <ul class="mt-5 space-y-3 text-white/70 leading-relaxed">
          <li class="relative pl-5 before:absolute before:left-0 before:top-3 before:h-1.5 before:w-1.5 before:rounded-full before:bg-[#FFF200]">
            <strong class="text-white">Камерное событие на&nbsp;15–40 человек</strong>
            (партнёрский ужин, частный юбилей, презентация в&nbsp;узком кругу)&nbsp;—
            200–500 тыс рублей
          </li>
          <li class="relative pl-5 before:absolute before:left-0 before:top-3 before:h-1.5 before:w-1.5 before:rounded-full before:bg-[#FFF200]">
            <strong class="text-white">Корпоратив или&nbsp;деловое событие на&nbsp;60–150 человек</strong>&nbsp;— 500 тыс – 1.5 млн рублей. Это самый частый диапазон
          </li>
          <li class="relative pl-5 before:absolute before:left-0 before:top-3 before:h-1.5 before:w-1.5 before:rounded-full before:bg-[#FFF200]">
            <strong class="text-white">Крупное мероприятие на&nbsp;200–300+ человек</strong>
            (юбилей компании, отраслевой форум, большой партнёрский вечер)&nbsp;—
            от&nbsp;1.5 до&nbsp;4 млн рублей
          </li>
          <li class="relative pl-5 before:absolute before:left-0 before:top-3 before:h-1.5 before:w-1.5 before:rounded-full before:bg-[#FFF200]">
            <strong class="text-white">Сложные комплексные проекты</strong>
            (многодневные форматы, открытия объектов с&nbsp;PR-составляющей, большие
            отраслевые форумы)&nbsp;— от&nbsp;5 миллионов и&nbsp;выше
          </li>
        </ul>
        <p class="mt-5 text-white/70 leading-relaxed md:text-lg">
          Эти цифры&nbsp;— общая статистика наших проектов, а&nbsp;не&nbsp;«пакетные
          предложения». Конкретная смета вашего мероприятия зависит от&nbsp;площадки,
          программы, состава подрядчиков и&nbsp;уровня технического оснащения.
        </p>
      </div>

      <div class="rounded-2xl border border-white/10 bg-white/[0.03] p-6 md:p-8">
        <h2 class="text-2xl font-semibold text-white md:text-3xl">
          Почему у&nbsp;нас нет пакетов «базовый/стандарт/премиум»
        </h2>
        <p class="mt-4 text-white/70 leading-relaxed md:text-lg">
          Готовые пакеты удобно продавать, но&nbsp;неудобно с&nbsp;ними жить.
          Реальные мероприятия редко укладываются в&nbsp;шаблон: бюджет может быть
          «средним», а&nbsp;требования&nbsp;— «премиум»; формат может быть камерным,
          а&nbsp;аудитория&nbsp;— статусной; событие может быть «бюджетным», но&nbsp;при&nbsp;этом
          критичным для&nbsp;имиджа компании.
        </p>
        <p class="mt-4 text-white/70 leading-relaxed md:text-lg">
          Поэтому каждое мероприятие мы&nbsp;собираем индивидуально под&nbsp;цели,
          аудиторию и&nbsp;бюджет. Это занимает чуть больше времени на&nbsp;этапе
          обсуждения, но&nbsp;даёт результат, в&nbsp;котором ничего лишнего и&nbsp;ничего
          не&nbsp;упущено.
        </p>
      </div>

      <div class="rounded-2xl border border-white/10 bg-white/[0.03] p-6 md:p-8">
        <h2 class="text-2xl font-semibold text-white md:text-3xl">
          Какие случаи нам подходят
        </h2>
        <p class="mt-4 text-white/70 leading-relaxed md:text-lg">
          Чтобы вам было проще понять, ваша&nbsp;ли это история:
        </p>
        <ul class="mt-5 space-y-3 text-white/70 leading-relaxed">
          <li class="relative pl-5 before:absolute before:left-0 before:top-3 before:h-1.5 before:w-1.5 before:rounded-full before:bg-[#FFF200]">
            Мероприятие проходит в&nbsp;Калининграде или&nbsp;Калининградской области
          </li>
          <li class="relative pl-5 before:absolute before:left-0 before:top-3 before:h-1.5 before:w-1.5 before:rounded-full before:bg-[#FFF200]">
            Бюджет от&nbsp;200 тысяч рублей или&nbsp;вы&nbsp;готовы обсуждать формат
            под&nbsp;имеющийся бюджет
          </li>
          <li class="relative pl-5 before:absolute before:left-0 before:top-3 before:h-1.5 before:w-1.5 before:rounded-full before:bg-[#FFF200]">
            Вам нужен полный цикл организации (концепция, площадка, подрядчики,
            координация) или&nbsp;координация в&nbsp;день при&nbsp;уже готовом сценарии
          </li>
          <li class="relative pl-5 before:absolute before:left-0 before:top-3 before:h-1.5 before:w-1.5 before:rounded-full before:bg-[#FFF200]">
            Событие имеет смысл и&nbsp;аудиторию: корпоративное, деловое, клиентское,
            частное торжество
          </li>
        </ul>
      </div>

      <div class="rounded-2xl border border-white/10 bg-white/[0.03] p-6 md:p-8">
        <h2 class="text-2xl font-semibold text-white md:text-3xl">
          Чего на&nbsp;этой странице нет (намеренно)
        </h2>
        <p class="mt-4 text-white/70 leading-relaxed md:text-lg">
          Мы&nbsp;не&nbsp;ставим на&nbsp;сайте онлайн-калькулятор стоимости мероприятия.
          Любая смета зависит от&nbsp;десятков параметров&nbsp;— площадка, технический
          райдер, состав программы, сезон, количество гостей, диетические особенности,
          требования к&nbsp;размещению. Калькулятор, который выдаёт «итоговую цифру
          за&nbsp;30 секунд», в&nbsp;этой работе не&nbsp;помогает. Поэтому формат
          прежний: получасовой бриф&nbsp;— и&nbsp;через 3–5 рабочих дней у&nbsp;вас
          на&nbsp;руках конкретная смета по&nbsp;вашему мероприятию.
        </p>
      </div>

    </div>
  </section>

  <div class="lab-divider-glow mx-auto max-w-6xl"></div>

  <ContactBlock />

  <MetrikaCounter slot="analytics" />
</DarkLayout>
