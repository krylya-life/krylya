---
/*
 * design-lab — изолированная песочница для альтернативного дизайна.
 * Основной сайт здесь не затрагивается. Маршрут: /design-lab/.
 * Тёмная тема, Inter, Aceternity / Magic UI.
 * Контент 1:1 с основной главной (src/components/blocks/*).
 */
import LabLayout from "../../design-lab/LabLayout.astro";
import { Spotlight } from "../../design-lab/components/Spotlight.tsx";
import { Meteors } from "../../design-lab/components/Meteors.tsx";
import { BorderBeam } from "../../design-lab/components/BorderBeam.tsx";
import KaliningradSilhouette from "../../design-lab/components/KaliningradSilhouette.astro";
import { business } from "../../config/business.ts";
import { getCollection } from "astro:content";

const allServices = await getCollection("services");
const services = allServices
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 3);

// На главную выносим только согласованные кейсы — `.business/products/overview.md`:
// АЭРО, ВКЛЮЧИ и фестиваль «ДОМ». Помечены featured: true.
const allCases = await getCollection("cases");
const cases = allCases
  .filter((c) => c.data.featured)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3);

const audiences = [
  {
    title: "Бизнесу с публичным лицом",
    description: "Презентации объектов и продуктов, открытия, вечера для клиентов и партнёров.",
  },
  {
    title: "Крупному бизнесу",
    description: "Корпоративы, юбилеи компании, отраслевые праздники, деловые конференции и форумы.",
  },
  {
    title: "Иногородним клиентам",
    description: "Проведём мероприятие в Калининграде, пока вы работаете из другого города. Знаем регион — знаем, где будет круто.",
  },
];

const whyPoints = [
  {
    title: "Одна команда вместо десяти переговоров",
    text: "Площадка, кейтеринг, ведущий, техника, флористика — мы сводим графики, согласования и ожидания в одну линию. У вас остаётся один контакт вместо десятка телефонов в записной книжке.",
  },
  {
    title: "Прозрачная смета",
    text: "Подрядчики идут в смете отдельной строкой по реальной цене — вы видите, куда уходит каждый рубль. Наши 10% — плата за организационную работу: концепцию, поиск, бюджет, ведение проекта.",
  },
  {
    title: "Команда на площадке в день события",
    text: "Тайминг, подрядчики, форс-мажоры — наша зона ответственности. Вы общаетесь с гостями, мы держим всё остальное.",
  },
];

const localMetrics = [
  { k: "Локально", v: "только Калининград и область" },
  { k: "Площадки", v: "от замков и особняков до индустриальных лофтов" },
  { k: "Команда", v: "подрядчики, проверенные десятками проектов" },
];

const steps = [
  { title: "Бриф", text: "30 минут разговора. Разбираем цели, формат, бюджет, ограничения." },
  { title: "Концепция и смета", text: "За 3–5 рабочих дней присылаем первый вариант идеи и сметы — основу для обсуждения." },
  { title: "Правки и утверждение", text: "Корректируем под ваши пожелания. Подписываем договор." },
  { title: "Продакшн", text: "Бронируем площадку, подрядчиков, согласовываем технические детали." },
  { title: "День Х", text: "Команда на месте. Тайминг, координация, форс-мажоры — наша задача." },
  { title: "Отчёт", text: "Фото- и видеоматериалы, финансовый отчёт, ретроспектива." },
];
---

<LabLayout title="design-lab — Крылья">
  <!-- ─── HERO ─── -->
  <section class="relative flex min-h-[92vh] w-full items-center overflow-hidden">
    <Spotlight client:load className="-top-40 left-0 md:-top-20 md:left-60" fill="#FFF200" />
    <div class="lab-aurora pointer-events-none"></div>
    <div class="lab-grid absolute inset-0"></div>

    <header class="absolute top-0 left-0 right-0 z-20 py-3">
      <div class="mx-auto flex w-full max-w-6xl items-center justify-between px-6 md:px-12">
        <a href="/design-lab/" class="group flex items-center gap-3">
          <img
            src="/brand/wings-logo-horizontal-white.png"
            alt="Крылья"
            width="280"
            height="175"
            class="h-20 w-auto drop-shadow-[0_0_28px_rgba(255,242,0,0.32)] md:h-28"
          />
          <span class="relative inline-flex h-2 w-2">
            {/* glow accent: пингующая точка, оттенок жёлтого не критичен */}
            <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-yellow-300 opacity-75"></span>
            <span class="relative inline-flex h-2 w-2 rounded-full bg-[#FFF200]"></span>
          </span>
        </a>
        <nav class="hidden items-center gap-8 text-sm text-white/70 md:flex">
          <a class="transition hover:text-white" href="#services">Услуги</a>
          <a class="transition hover:text-white" href="#cases">Кейсы</a>
          <a class="transition hover:text-white" href="#how">Как работаем</a>
          <a class="transition hover:text-white" href="#contact">Контакты</a>
        </nav>
        <a
          href="#contact"
          class="hidden items-center rounded-full border border-white/20 px-5 py-2.5 text-sm font-medium text-white/85 transition hover:border-[#FFF200] hover:text-white md:inline-flex"
        >
          Обсудить мероприятие
        </a>
      </div>
    </header>

    <div class="relative z-10 mx-auto w-full max-w-6xl px-6 pt-32 md:px-12 md:pt-24">
      <div class="mb-6 inline-flex items-center gap-2 rounded-full border border-white/10 bg-white/[0.03] px-3.5 py-1.5 text-xs text-white/70 backdrop-blur">
        <span class="relative inline-flex h-1.5 w-1.5">
          {/* glow accent: пингующая точка, оттенок не критичен */}
          <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-yellow-300 opacity-70"></span>
          <span class="relative inline-flex h-1.5 w-1.5 rounded-full bg-[#FFF200]"></span>
        </span>
        Команда организаторов <span class="text-[#FFF200]">·</span> Калининград
      </div>

      <h1 class="max-w-5xl text-4xl font-semibold leading-[1.05] tracking-[-0.03em] text-white md:text-5xl lg:text-6xl">
        Организуем мероприятия
        <span class="relative inline-block">
          <span class="lab-gradient-text">под&nbsp;ключ</span>
          {/* glow accent: размытое свечение под заголовком, точный hex не критичен */}
          <span class="absolute -bottom-1 left-0 right-0 h-2 rounded-full bg-yellow-300/30 blur-md"></span>
        </span>
      </h1>

      <p class="mt-8 max-w-3xl text-base leading-relaxed text-white/70 md:text-lg">
        Мы отвечаем за концепцию, площадку, подрядчиков, смету и команду на&nbsp;площадке.
        Вам остаётся быть на&nbsp;собственном празднике, а&nbsp;не&nbsp;за&nbsp;его кулисами.
      </p>

      <div class="mt-10 flex flex-wrap gap-3">
        <a
          href={`tel:${business.phone}`}
          class="lab-glow inline-flex items-center justify-center gap-2 rounded-full bg-[#FFF200] px-6 py-3.5 text-sm font-semibold text-black no-underline transition-colors hover:bg-[#FFF566]"
        >
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
          {business.phoneDisplay}
        </a>
        <a
          href={`https://t.me/${business.telegramPersonal.replace("@", "")}`}
          target="_blank"
          rel="noopener noreferrer"
          class="group relative inline-flex items-center justify-center gap-2 overflow-hidden rounded-full bg-[#FFF200] px-6 py-3.5 text-sm font-semibold text-black transition-colors hover:bg-[#FFF566]"
        >
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m22 2-7 20-4-9-9-4 20-7z"/></svg>
          Telegram
        </a>
      </div>

      <ul class="mt-14 grid grid-cols-2 gap-y-3 text-sm text-white/55 md:flex md:flex-wrap md:gap-x-10">
        <li class="flex items-center gap-2">
          <span class="inline-block h-1 w-1 rounded-full bg-[#FFF200]"></span>
          Полный цикл организации
        </li>
        <li class="flex items-center gap-2">
          <span class="inline-block h-1 w-1 rounded-full bg-[#FFF200]"></span>
          Прозрачная смета
        </li>
        <li class="flex items-center gap-2">
          <span class="inline-block h-1 w-1 rounded-full bg-[#FFF200]"></span>
          Команда в день события
        </li>
      </ul>
    </div>

    <div class="pointer-events-none absolute inset-0 overflow-hidden">
      <Meteors client:load number={14} />
    </div>
  </section>

  <!-- разделитель Hero → Audience -->
  <div class="lab-divider-glow mx-auto max-w-6xl"></div>

  <!-- ─── AUDIENCE ─── -->
  <section id="audience" class="lab-glow-top relative px-6 py-14 md:px-12 md:py-20">
    <div class="mx-auto max-w-6xl">
      <div class="mb-10 max-w-3xl">
        <h2 class="text-3xl font-semibold leading-tight tracking-tight text-white md:text-5xl">
          Для кого мы работаем
        </h2>
        <span class="mt-4 inline-block h-1 w-12 bg-[#FFF200]"></span>
      </div>

      <div class="grid gap-5 md:grid-cols-3">
        {audiences.map((a) => (
          <div class="lab-magic-card lab-cursor-wings group h-full overflow-hidden rounded-2xl border border-white/10 bg-white/[0.03] p-6 transition-colors hover:border-[#FFF200]/30">
            <span class="lab-magic-card__glow"></span>
            <h3 class="mb-3 text-xl font-semibold text-white">{a.title}</h3>
            <p class="text-sm leading-relaxed text-white/65">{a.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <div class="lab-divider-glow mx-auto max-w-6xl"></div>

  <!-- ─── WHY TURNKEY (альтернативный фон) ─── -->
  <section class="lab-bg-alt relative px-6 py-14 md:px-12 md:py-20">
    <div class="mx-auto max-w-6xl">
      <div class="mb-10 max-w-3xl">
        <h2 class="text-3xl font-semibold leading-tight tracking-tight text-white md:text-5xl">
          «Под&nbsp;ключ» — буквально
        </h2>
        <span class="mt-4 inline-block h-1 w-12 bg-[#FFF200]"></span>
        <p class="mt-6 text-white/65 md:text-lg leading-relaxed">
          Концепция, площадка, подрядчики, бюджет, день события — на&nbsp;нашей стороне.
          Вы&nbsp;получаете готовое мероприятие, а&nbsp;не&nbsp;пакет задач, которые нужно довести
          до&nbsp;результата.
        </p>
      </div>

      <div class="grid gap-4 md:grid-cols-3">
        {whyPoints.map((p) => (
          <div class="relative overflow-hidden rounded-2xl border border-white/10 bg-white/[0.02] p-6">
            <BorderBeam client:visible duration={14} colorFrom="#FFF200" colorTo="#FFA500" />
            <h3 class="text-lg font-semibold text-white">{p.title}</h3>
            <p class="mt-3 text-sm leading-relaxed text-white/60">{p.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <div class="lab-divider-glow mx-auto max-w-6xl"></div>

  <!-- ─── SERVICES ─── -->
  <section id="services" class="relative px-6 py-14 md:px-12 md:py-20">
    <div class="mx-auto max-w-6xl">
      <div class="mb-10 flex flex-wrap items-end justify-between gap-6">
        <div class="max-w-2xl">
          <h2 class="text-3xl font-semibold leading-tight tracking-tight text-white md:text-5xl">
            Чем занимаемся
          </h2>
          <span class="mt-4 inline-block h-1 w-12 bg-[#FFF200]"></span>
          <p class="mt-6 max-w-2xl text-white/65 md:text-lg leading-relaxed">
            Полный цикл организации мероприятия — от&nbsp;первого брифа до&nbsp;отчёта после события.
          </p>
        </div>
        <a
          href="/services/"
          class="inline-flex items-center gap-2 rounded-full border border-white/15 bg-white/[0.03] px-5 py-2.5 text-sm font-medium text-white/85 transition hover:border-white/30 hover:text-white"
        >
          Все направления
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M13 5l7 7-7 7"/></svg>
        </a>
      </div>

      <div class="grid gap-5 md:grid-cols-3">
        {services.map((s) => (
          <a
            href={`/services/${s.data.slug}/`}
            class="lab-magic-card lab-cursor-wings group flex min-h-[200px] flex-col justify-between overflow-hidden rounded-2xl border border-white/10 bg-white/[0.03] p-6 no-underline transition-colors hover:border-[#FFF200]/30"
          >
            <span class="lab-magic-card__glow"></span>
            <div>
              <h3 class="text-xl font-semibold text-white">{s.data.title}</h3>
              <p class="mt-3 text-sm leading-relaxed text-white/60">{s.data.description}</p>
            </div>
            <span class="mt-6 inline-flex items-center gap-2 text-sm font-medium text-[#FFF200]">
              Подробнее
              <span class="inline-block h-px w-6 bg-[#FFF200] transition-all group-hover:w-10"></span>
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <div class="lab-divider-glow mx-auto max-w-6xl"></div>

  <!-- ─── LOCAL EXPERTISE (feature-панель с сильным градиентом + силуэт города) ─── -->
  <section class="lab-bg-feature relative overflow-hidden px-6 py-14 md:px-12 md:py-20">
    <KaliningradSilhouette />
    <div class="relative mx-auto max-w-6xl">
      <div class="grid gap-12 md:grid-cols-5 md:items-center">
        <div class="md:col-span-3">
          <p class="mb-4 inline-flex items-center gap-2 text-xs font-semibold uppercase tracking-[0.25em] text-[#FFF200]">
            <span class="inline-block h-px w-8 bg-[#FFF200]"></span>
            Локальная экспертиза
          </p>

          <h2 class="text-3xl font-semibold leading-tight tracking-tight text-white md:text-5xl">
            Знаем регион — знаем,
            <span class="relative inline-block">
              <span class="lab-gradient-text">что&nbsp;здесь работает</span>
            </span>
          </h2>
          <span class="mt-4 inline-block h-1 w-12 bg-[#FFF200]"></span>

          <p class="mt-8 text-white/65 md:text-lg leading-relaxed">
            Калининград и область — наш единственный регион работы. Знакомы
            с площадками от исторических особняков и замков до индустриальных
            лофтов и природных локаций на побережье.
          </p>

          <p class="mt-5 text-white/65 md:text-lg leading-relaxed">
            Подрядчики, которых мы зовём, проверены десятками проектов — а&nbsp;не&nbsp;взяты
            с&nbsp;первой страницы поиска. Для иногороднего клиента это значит
            <span class="text-white">меньше рисков и&nbsp;меньше сюрпризов</span> в&nbsp;день события.
          </p>
        </div>

        <ul class="md:col-span-2 space-y-3">
          {localMetrics.map((m) => (
            <li class="relative overflow-hidden rounded-2xl border-l-2 border-[#FFF200] bg-white/[0.03] py-4 pl-5 pr-4">
              <strong class="block text-2xl font-bold text-[#FFF200] tracking-tight">{m.k}</strong>
              <span class="mt-1 block text-sm text-white/60">{m.v}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <div class="lab-divider-glow mx-auto max-w-6xl"></div>

  <!-- ─── CASES (альтернативный фон) ─── -->
  <section id="cases" class="lab-bg-alt relative px-6 py-14 md:px-12 md:py-20">
    <div class="mx-auto max-w-6xl">
      <div class="mb-10 flex flex-wrap items-end justify-between gap-6">
        <div class="max-w-2xl">
          <h2 class="text-3xl font-semibold leading-tight tracking-tight text-white md:text-5xl">
            Кейсы
          </h2>
          <span class="mt-4 inline-block h-1 w-12 bg-[#FFF200]"></span>
          <p class="mt-6 max-w-2xl text-white/65 md:text-lg leading-relaxed">
            Несколько недавних проектов — задача, решение и&nbsp;материалы с&nbsp;площадки.
          </p>
        </div>
        <a
          href="/cases/"
          class="inline-flex items-center gap-2 rounded-full border border-white/15 bg-white/[0.03] px-5 py-2.5 text-sm font-medium text-white/85 transition hover:border-white/30 hover:text-white"
        >
          Все кейсы
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M13 5l7 7-7 7"/></svg>
        </a>
      </div>

      <div class="mx-auto grid max-w-4xl gap-4 md:grid-cols-3">
        {cases.map((c) => (
          <a
            href={`/cases/${c.data.slug}/`}
            class="group lab-cursor-wings relative block aspect-square overflow-hidden rounded-2xl no-underline"
          >
            <img
              src={`/assets/cases/${c.data.slug}/${c.data.cover}`}
              alt={c.data.title}
              class="absolute inset-0 h-full w-full object-cover transition-transform duration-700 ease-out group-hover:scale-105"
              loading="lazy"
            />
            {/* Затемнение снизу, чтобы текст читался */}
            <div class="absolute inset-0 bg-gradient-to-t from-black/85 via-black/35 to-transparent"></div>

            <div class="absolute inset-x-0 bottom-0 p-5">
              <p class="mb-1.5 text-[10px] font-semibold uppercase tracking-[0.18em] text-[#FFF200]">
                {c.data.client}
              </p>
              <h3 class="text-base font-semibold leading-tight tracking-tight text-white md:text-lg">
                {c.data.title}
              </h3>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <div class="lab-divider-glow mx-auto max-w-6xl"></div>

  <!-- ─── HOW WE WORK ─── -->
  <section id="how" class="relative px-6 py-14 md:px-12 md:py-20">
    <div class="mx-auto max-w-6xl">
      <div class="mb-10 max-w-3xl">
        <h2 class="text-3xl font-semibold leading-tight tracking-tight text-white md:text-5xl">
          Как мы работаем
        </h2>
        <span class="mt-4 inline-block h-1 w-12 bg-[#FFF200]"></span>
        <p class="mt-6 text-white/65 md:text-lg leading-relaxed">
          Шесть прозрачных шагов от&nbsp;первого звонка до&nbsp;итогового отчёта.
          На&nbsp;каждом шаге у&nbsp;вас есть точка контроля.
        </p>
      </div>

      <ol class="relative mx-auto max-w-3xl">
        {/* вертикальная линия — glow accent: градиентная вертикаль с прозрачными концами, оттенок не критичен */}
        <div class="absolute left-5 top-5 bottom-5 w-px bg-gradient-to-b from-yellow-300/0 via-white/15 to-yellow-300/0"></div>

        {steps.map((s, i) => {
          const isClimax = s.title === "День Х";
          return (
            <li class="relative grid grid-cols-[2.5rem_1fr] gap-5 pb-10 last:pb-0">
              <span
                class:list={[
                  "relative z-10 inline-flex h-10 w-10 items-center justify-center rounded-full font-mono text-sm font-semibold transition-transform",
                  isClimax
                    ? "bg-[#FFF200] text-black shadow-[0_0_28px_-6px_rgba(255,242,0,0.7)]"
                    : "border border-white/15 bg-[#0B0B10] text-[#FFF200]",
                ]}
              >
                {String(i + 1).padStart(2, "0")}
              </span>
              <div class="pt-1.5">
                <h3
                  class:list={[
                    "text-lg font-semibold tracking-tight md:text-xl",
                    isClimax
                      ? "inline-block rounded-lg border border-[#FFF200]/55 bg-[#FFF200]/[0.06] px-3 py-1 text-[#FFF200] shadow-[0_0_22px_-10px_rgba(255,242,0,0.6)]"
                      : "text-white",
                  ]}
                >
                  {s.title}
                </h3>
                <p class="mt-2 max-w-xl text-sm leading-relaxed text-white/60 md:text-base">
                  {s.text}
                </p>
              </div>
            </li>
          );
        })}
      </ol>
    </div>
  </section>

  <!-- разделитель How → Contact -->
  <div class="lab-divider-glow mx-auto max-w-6xl"></div>

  <!-- ─── CONTACT (верхнее свечение) ─── -->
  <section id="contact" class="lab-glow-top relative px-6 py-14 md:px-12 md:py-20">
    <div class="mx-auto max-w-6xl">
      <div class="grid gap-12 lg:grid-cols-12">
        <div class="lg:col-span-5">
          <h2 class="text-3xl font-semibold leading-tight tracking-tight text-white md:text-5xl">
            Расскажите о&nbsp;мероприятии
          </h2>
          <span class="mt-4 inline-block h-1 w-12 bg-[#FFF200]"></span>
          <p class="mt-6 max-w-md text-white/65 md:text-lg leading-relaxed">
            Заполните форму или свяжитесь напрямую — обычно отвечаем
            в&nbsp;течение&nbsp;рабочего&nbsp;дня.
          </p>

          <p class="mt-10 text-sm text-white/50">Калининград и&nbsp;область</p>
        </div>

        <div class="relative overflow-hidden rounded-2xl border border-white/10 bg-white/[0.02] p-8 md:p-10 lg:col-span-7">
          <BorderBeam client:visible duration={20} colorFrom="#FFF200" colorTo="#FFD040" />

          <div class="flex flex-wrap gap-3">
            <a
              href={`tel:${business.phone}`}
              class="inline-flex items-center justify-center gap-2 rounded-full bg-[#FFF200] px-6 py-3.5 text-sm font-semibold text-black no-underline transition-colors hover:bg-[#FFF566]"
            >
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
              {business.phoneDisplay}
            </a>

            <a
              href={`https://t.me/${business.telegramPersonal.replace("@", "")}`}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center justify-center gap-2 rounded-full bg-[#FFF200] px-6 py-3.5 text-sm font-semibold text-black no-underline transition-colors hover:bg-[#FFF566]"
            >
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m22 2-7 20-4-9-9-4 20-7z"/></svg>
              Telegram
            </a>
          </div>

          <a
            href={`mailto:${business.email}`}
            class="mt-6 inline-flex w-fit items-center gap-2 text-sm text-white/60 underline decoration-[#FFF200]/50 underline-offset-4 transition hover:text-white"
          >
            или&nbsp;на&nbsp;почту: {business.email}
          </a>

          <p class="mt-4 flex items-center gap-2 text-sm text-white/55">
            <span class="relative inline-flex h-1.5 w-1.5">
              {/* glow accent: пингующая точка, оттенок не критичен */}
              <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-yellow-300 opacity-70"></span>
              <span class="relative inline-flex h-1.5 w-1.5 rounded-full bg-[#FFF200]"></span>
            </span>
            Обычно отвечаем в&nbsp;течение часа
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ─── FOOTER ─── -->
  <footer class="relative px-6 py-12 md:px-12">
    <div class="lab-divider mb-10 mx-auto max-w-6xl"></div>
    <div class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-6 text-xs text-white/40">
      <div class="flex items-end gap-7">
        <img
          src="/brand/wings-logo-horizontal-white.png"
          alt="Крылья"
          width="200"
          height="125"
          class="h-12 w-auto opacity-85"
        />
        <span class="pb-1.5 leading-none">Калининград <span class="text-[#FFF200]">·</span> {business.foundingDate}</span>
      </div>
      <div class="flex flex-wrap gap-6">
        <span>{business.legalName}</span>
        <span>ИНН {business.taxId}</span>
        <span>ОГРНИП {business.ogrnip}</span>
      </div>
      <a href="/" class="underline decoration-[#FFF200]/40 underline-offset-4 transition hover:text-white">← вернуться на основной сайт</a>
    </div>
  </footer>
</LabLayout>
