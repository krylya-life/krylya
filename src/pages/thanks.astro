---
import DarkLayout from "../layouts/DarkLayout.astro";
import MetrikaCounter from "../components/MetrikaCounter.astro";
import { business } from "../config/business.ts";

const telegramHandle = business.telegramPersonal.replace("@", "");
---

<DarkLayout
  title="Спасибо — Крылья"
  description="Заявка получена. Мы свяжемся с вами в течение рабочего дня."
  noindex
>
  <section class="relative flex min-h-[70vh] items-center overflow-hidden px-6 py-14 md:px-12 md:py-20">
    <div class="lab-aurora pointer-events-none"></div>
    <div class="relative mx-auto max-w-2xl text-center">
      <!-- glow accent: пингующая жёлтая точка -->
      <span class="relative mx-auto mb-8 inline-flex h-3 w-3">
        <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-[#FFF200] opacity-75"></span>
        <span class="relative inline-flex h-3 w-3 rounded-full bg-[#FFF200]"></span>
      </span>

      <h1 class="text-4xl font-semibold tracking-tight text-white md:text-6xl">
        Спасибо!
      </h1>

      <p class="mt-6 text-lg text-white/75 md:text-xl leading-relaxed">
        Мы получили вашу заявку. Обычно отвечаем в&nbsp;течение рабочего дня —
        часто быстрее.
      </p>

      <p class="mt-4 text-base text-white/60 leading-relaxed">
        Если задача срочная — позвоните или напишите в&nbsp;Telegram напрямую.
      </p>

      <div class="mt-10 flex flex-wrap justify-center gap-3">
        <a
          href="/"
          class="inline-flex min-h-[44px] items-center justify-center rounded-full bg-[#FFF200] px-6 py-3.5 text-sm font-semibold text-black no-underline transition-colors hover:bg-[#FFF566]"
        >
          На главную
        </a>
        <a
          href={`tel:${business.phone}`}
          class="inline-flex min-h-[44px] items-center justify-center rounded-full border border-white/20 px-6 py-3.5 text-sm font-semibold text-white no-underline transition-colors hover:border-[#FFF200]/40"
        >
          {business.phoneDisplay}
        </a>
        <a
          href={`https://t.me/${telegramHandle}`}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex min-h-[44px] items-center justify-center rounded-full border border-white/20 px-6 py-3.5 text-sm font-semibold text-white no-underline transition-colors hover:border-[#FFF200]/40"
        >
          Telegram
        </a>
      </div>
    </div>
  </section>

  <MetrikaCounter slot="analytics" />
</DarkLayout>
