---
import DarkLayout from "../layouts/DarkLayout.astro";
import Seo from "../components/Seo.astro";
import JsonLdGraph from "../components/JsonLdGraph.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import MetrikaCounter from "../components/MetrikaCounter.astro";
import ContactBlock from "../components/blocks/ContactBlock.astro";

const seoTitle = "О нас — ивент-агентство Крылья в Калининграде";
const seoDescription =
  "Команда Крыльев: организуем мероприятия в Калининграде и области. Надёжность, локальная экспертиза, прозрачная 10%-модель. Мария Вострикова и Кристина Прус — ядро агентства.";

const crumbs = [
  { label: "Главная", href: "/" },
  { label: "О нас", href: "/about/" },
];

const pillars = [
  {
    title: "Надёжность",
    text: "Мы не пропадаем после подписания договора. Подрядчики идут в смете отдельной строкой по реальной цене, мы держим связь с площадкой и командой в день события. У вас один контакт вместо десяти телефонов — и одна точка ответственности за весь результат.",
  },
  {
    title: "Локальная экспертиза",
    text: "Калининград и область — наш единственный регион работы. Знакомы с площадками от исторических особняков и замков до индустриальных лофтов и побережья. Подрядчики — декораторы, ведущие, техники, кейтеринг, фотографы — проверены десятками проектов.",
  },
  {
    title: "Креатив",
    text: "Концепция — не самоцель, а ответ на задачу клиента. Сначала разбираем бизнес-цель и формат, потом предлагаем идею. Не делаем «вау ради вау» — делаем то, что работает на ваше мероприятие и помнится гостям на следующий день, а не только в момент.",
  },
];

const teamHighlights = [
  {
    name: "Мария Вострикова",
    role: "Основатель, главный продюсер",
    bio: "Семь с лишним лет в индустрии. Лично ведёт ключевые проекты, общается с клиентами на этапе концепции и брифа. Берёт на себя ответственность за результат и держит связь с заказчиком на всех этапах подготовки.",
  },
  {
    name: "Кристина Прус",
    role: "Менеджер проектов",
    bio: "Отвечает за тайминг, площадки, подрядчиков и операционную часть проекта. На связи с командой и клиентом в день события — следит, чтобы всё шло по плану, и решает мелкие вопросы до того, как они станут крупными.",
  },
  {
    name: "Сергей Дубровский",
    role: "Координатор проектов",
    bio: "Постоянно привлекается на отдельные проекты. Координирует подрядчиков на площадке, помогает с логистикой и техническими моментами в день мероприятия.",
  },
  {
    name: "Привлечённая команда",
    role: "Декораторы, ведущие, техники",
    bio: "Под каждое мероприятие собираем команду из проверенных партнёров — декораторы, ведущие, кейтеринг, фотографы и видеографы, технические подрядчики, площадки. Состав адаптируется под формат и масштаб события.",
  },
];

const facts = [
  { value: "7+", label: "лет личного опыта Маши в индустрии" },
  { value: "2024", label: "год основания агентства" },
  { value: "1", label: "регион — Калининград и область" },
  { value: "10%", label: "прозрачная модель агентского вознаграждения" },
];
---

<DarkLayout title={seoTitle} description={seoDescription}>
  <Seo
    slot="seo"
    title={seoTitle}
    description={seoDescription}
    pathname="/about/"
  />
  <JsonLdGraph slot="seo" />

  <!-- Hero -->
  <section class="relative overflow-hidden px-6 pt-32 pb-14 md:px-12 md:pt-40 md:pb-20">
    <div class="lab-aurora pointer-events-none"></div>
    <div class="relative mx-auto max-w-6xl">
      <Breadcrumbs crumbs={crumbs} />
      <h1 class="mt-6 text-4xl font-semibold tracking-tight text-white md:text-6xl">
        Кто мы
      </h1>
      <span class="mt-4 inline-block h-1 w-12 bg-[#FFF200]"></span>
      <p class="mt-8 text-lg leading-relaxed text-white/75 md:text-xl">
        Крылья — ивент-агентство в&nbsp;Калининграде. Работаем с&nbsp;корпоративными
        клиентами, девелоперами и&nbsp;иногородними заказчиками. Организуем мероприятия
        под&nbsp;ключ — от&nbsp;концепции и&nbsp;брифа до&nbsp;команды на&nbsp;площадке
        в&nbsp;день события.
      </p>
      <p class="mt-6 text-base leading-relaxed text-white/65 md:text-lg">
        Агентство основано в&nbsp;2024 году Марией Востриковой — организатором
        с&nbsp;семью годами личного опыта в&nbsp;event. С тех пор «Крылья» выросли
        из&nbsp;одного человека в&nbsp;команду с&nbsp;ядром из&nbsp;двух основателей
        и&nbsp;кругом проверенных координаторов и&nbsp;подрядчиков, которых
        мы&nbsp;собираем под&nbsp;каждый проект.
      </p>
    </div>
  </section>

  <div class="lab-divider-glow mx-auto max-w-6xl"></div>

  <!-- 3 опоры бренда -->
  <section class="relative px-6 py-14 md:px-12 md:py-20">
    <div class="mx-auto max-w-6xl">
      <h2 class="text-3xl font-semibold tracking-tight text-white md:text-5xl">
        На&nbsp;чём стоим
      </h2>
      <span class="mt-4 inline-block h-1 w-12 bg-[#FFF200]"></span>
      <p class="mt-6 max-w-2xl text-white/65 md:text-lg leading-relaxed">
        Главный месседж агентства — «надёжный партнёр под&nbsp;ключ
        в&nbsp;Калининграде». Креатив и&nbsp;цена важны, но&nbsp;вторичны
        после первых двух опор. Вот что это значит на&nbsp;практике.
      </p>
      <div class="mt-12 grid gap-5 md:grid-cols-3">
        {pillars.map((p, i) => (
          <div class="rounded-2xl border border-white/10 bg-white/[0.03] p-6">
            <p class="mb-4 font-mono text-xs text-[#FFF200]">
              {String(i + 1).padStart(2, "0")}
            </p>
            <h3 class="text-xl font-semibold text-white">{p.title}</h3>
            <p class="mt-3 text-sm leading-relaxed text-white/65">{p.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <div class="lab-divider-glow mx-auto max-w-6xl"></div>

  <!-- Факты -->
  <section class="lab-bg-alt relative px-6 py-14 md:px-12 md:py-20">
    <div class="mx-auto max-w-6xl">
      <h2 class="text-3xl font-semibold tracking-tight text-white md:text-5xl">
        Коротко о&nbsp;нас
      </h2>
      <span class="mt-4 inline-block h-1 w-12 bg-[#FFF200]"></span>
      <div class="mt-10 grid grid-cols-2 gap-6 md:grid-cols-4">
        {facts.map((f) => (
          <div class="border-l-2 border-[#FFF200] pl-4">
            <p class="text-3xl font-semibold text-white md:text-4xl">{f.value}</p>
            <p class="mt-2 text-sm text-white/60 leading-snug">{f.label}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <div class="lab-divider-glow mx-auto max-w-6xl"></div>

  <!-- Команда -->
  <section class="relative px-6 py-14 md:px-12 md:py-20">
    <div class="mx-auto max-w-6xl">
      <h2 class="text-3xl font-semibold tracking-tight text-white md:text-5xl">
        Команда
      </h2>
      <span class="mt-4 inline-block h-1 w-12 bg-[#FFF200]"></span>
      <p class="mt-6 max-w-2xl text-white/65 md:text-lg leading-relaxed">
        Основатели агентства лично ведут ключевые проекты. На&nbsp;больших мероприятиях
        привлекаем проверенных координаторов и&nbsp;подрядчиков из&nbsp;нашей команды.
        Состав адаптируется под&nbsp;формат и&nbsp;масштаб события.
      </p>
      <div
        class="mt-12 grid gap-6 md:grid-cols-2"
        itemscope
        itemtype="https://schema.org/Organization"
      >
        <meta itemprop="name" content="Крылья" />
        {teamHighlights.map((m) => (
          <div
            class="rounded-2xl border border-white/10 bg-white/[0.02] p-6"
            itemprop="member"
            itemscope
            itemtype="https://schema.org/Person"
          >
            <h3 class="text-xl font-semibold text-white" itemprop="name">{m.name}</h3>
            <p class="mt-1 text-sm text-[#FFF200]" itemprop="jobTitle">{m.role}</p>
            <p
              class="mt-4 text-sm leading-relaxed text-white/65"
              itemprop="description"
            >
              {m.bio}
            </p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <div class="lab-divider-glow mx-auto max-w-6xl"></div>

  <!-- Как работаем — короткий блок -->
  <section class="relative px-6 py-14 md:px-12 md:py-20">
    <div class="mx-auto max-w-6xl">
      <h2 class="text-3xl font-semibold tracking-tight text-white md:text-5xl">
        Как мы работаем
      </h2>
      <span class="mt-4 inline-block h-1 w-12 bg-[#FFF200]"></span>
      <p class="mt-8 text-lg leading-relaxed text-white/75">
        После брифа мы&nbsp;готовим концепцию и&nbsp;прозрачную смету за&nbsp;3–5
        рабочих дней. Подрядчики идут в&nbsp;смете отдельной строкой по&nbsp;реальной
        цене — наше вознаграждение всегда видно отдельным процентом. Это и&nbsp;есть
        «прозрачная 10%-модель»: вы&nbsp;понимаете, за&nbsp;что платите, и&nbsp;знаете,
        что цена не&nbsp;«накручена сверху».
      </p>
      <p class="mt-6 text-base leading-relaxed text-white/65 md:text-lg">
        В&nbsp;день мероприятия команда на&nbsp;площадке держит тайминг и&nbsp;связь
        со&nbsp;всеми подрядчиками. От&nbsp;вас не&nbsp;требуется ничего, кроме
        присутствия в&nbsp;роли заказчика или гостя — мы&nbsp;берём операционку
        на&nbsp;себя.
      </p>
      <p class="mt-6 text-base leading-relaxed text-white/65 md:text-lg">
        Подробнее о&nbsp;подходе и&nbsp;услугах — на&nbsp;странице
        <a
          href="/services/"
          class="text-[#FFF200] underline decoration-[#FFF200]/40 underline-offset-4 hover:decoration-[#FFF200]"
        >направлений работы</a>
        и&nbsp;в&nbsp;<a
          href="/cases/"
          class="text-[#FFF200] underline decoration-[#FFF200]/40 underline-offset-4 hover:decoration-[#FFF200]"
        >наших кейсах</a>.
      </p>
    </div>
  </section>

  <div class="lab-divider-glow mx-auto max-w-6xl"></div>

  <ContactBlock />

  <MetrikaCounter slot="analytics" />
</DarkLayout>
