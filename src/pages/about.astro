---
import DarkLayout from "../layouts/DarkLayout.astro";
import Seo from "../components/Seo.astro";
import JsonLdGraph from "../components/JsonLdGraph.astro";
import MetrikaCounter from "../components/MetrikaCounter.astro";

const seoTitle = "О нас — ивент-агентство Крылья в Калининграде";
const seoDescription =
  "Страница о команде агентства Крылья готовится. Пока загляните в услуги и кейсы.";
---

<DarkLayout title={seoTitle} description={seoDescription}>
  <Seo
    slot="seo"
    title={seoTitle}
    description={seoDescription}
    pathname="/about/"
  />
  <JsonLdGraph slot="seo" />

  <section class="relative px-6 pt-40 pb-24 md:px-12 md:pt-48 md:pb-32">
    <div class="mx-auto max-w-2xl text-center">
      <span class="inline-flex items-center rounded-full border border-white/15 bg-white/[0.05] px-4 py-1.5 text-xs font-medium uppercase tracking-[0.2em] text-white/70">
        В&nbsp;разработке
      </span>
      <h1 class="mt-6 text-3xl font-semibold tracking-tight text-white md:text-5xl">
        Страница готовится
      </h1>
      <p class="mt-5 text-base leading-relaxed text-white/65 md:text-lg">
        Мы&nbsp;обновляем рассказ о&nbsp;команде и&nbsp;подходе. Совсем скоро здесь
        появится новая версия. А&nbsp;пока загляните в&nbsp;услуги и&nbsp;кейсы.
      </p>
      <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
        <a
          href="/services/"
          class="inline-flex items-center justify-center rounded-full bg-[#FFF200] px-6 py-3 text-sm font-semibold text-black no-underline transition-colors hover:bg-[#FFF566]"
        >
          Услуги
        </a>
        <a
          href="/cases/"
          class="inline-flex items-center justify-center rounded-full border border-white/15 bg-white/[0.03] px-6 py-3 text-sm font-medium text-white/85 no-underline transition hover:border-white/30 hover:text-white"
        >
          Кейсы
        </a>
        <a
          href="/contacts/"
          class="inline-flex items-center justify-center rounded-full border border-white/15 bg-white/[0.03] px-6 py-3 text-sm font-medium text-white/85 no-underline transition hover:border-white/30 hover:text-white"
        >
          Контакты
        </a>
      </div>
    </div>
  </section>

  <MetrikaCounter slot="analytics" />
</DarkLayout>
