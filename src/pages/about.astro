---
import DarkLayout from "../layouts/DarkLayout.astro";
import Seo from "../components/Seo.astro";
import JsonLdGraph from "../components/JsonLdGraph.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import MetrikaCounter from "../components/MetrikaCounter.astro";
import ContactBlock from "../components/blocks/ContactBlock.astro";

const seoTitle = "О нас — ивент-агентство Крылья в Калининграде";
const seoDescription =
  "Команда Крыльев: организуем мероприятия в Калининграде и области. Надёжность, локальная экспертиза, прозрачная 10%-модель. Мария Вострикова и Кристина Прус — ядро агентства.";

const crumbs = [
  { label: "Главная", href: "/" },
  { label: "О нас", href: "/about/" },
];

const pillars = [
  {
    title: "Надёжность",
    text: "Мы рядом на всех этапах — от подписания договора до последней минуты события. Подрядчики идут в смете отдельной строкой по реальной цене, а связь с площадкой и командой — на нашей стороне. У вас один контакт, и за весь результат отвечаем мы.",
  },
  {
    title: "Локальная экспертиза",
    text: "Калининград и область — наш единственный регион работы. Знакомы с площадками от исторических особняков и замков до индустриальных лофтов и побережья. Подрядчики — декораторы, ведущие, техники, кейтеринг, фотографы — проверены десятками проектов.",
  },
  {
    title: "Креатив",
    text: "Концепция — не самоцель, а ответ на задачу клиента. Сначала разбираем бизнес-цель и формат, потом предлагаем идею — такую, что работает на ваше мероприятие и остаётся в памяти гостей не только в момент праздника, но и надолго после.",
  },
];

const teamHighlights = [
  {
    name: "Мария Вострикова",
    role: "Машет Крыльями",
    photo: "/team/maria.jpg",
    bio: "Придумывает концепции, ведёт ключевые проекты и лично читает каждый бриф. С неё начинается и настроение команды, и первое впечатление клиента.",
  },
  {
    name: "Кристина Прус",
    role: "Королева таблиц и графиков",
    photo: "/team/kristina.jpg",
    bio: "Тайминг, сметы, площадки, подрядчики — всё под контролем. Рядом с ней не нужен магний: на любую проблему уже готов план и пара запасных.",
  },
  {
    name: "Сергей Дубровский",
    role: "Человек, который всё успевает",
    photo: "/team/sergey.jpg",
    bio: "Вы только подумали, что сцену хорошо бы передвинуть, — а он уже передвинул её в лучшее место. На площадке решает вопросы раньше, чем их задают.",
  },
  {
    name: "Надёжные подрядчики",
    role: "Проверены годами",
    bio: "Декораторы, ведущие, кейтеринг, свет и звук, флористы, фото и видео — те, с кем за плечами десятки проектов. Под каждое мероприятие собираем свой состав.",
  },
];
---

<DarkLayout title={seoTitle} description={seoDescription}>
  <Seo
    slot="seo"
    title={seoTitle}
    description={seoDescription}
    pathname="/about/"
  />
  <JsonLdGraph slot="seo" />

  <!-- Hero -->
  <section class="relative overflow-hidden px-6 pt-32 pb-14 md:px-12 md:pt-40 md:pb-20">
    <div class="lab-aurora pointer-events-none"></div>
    <div class="relative mx-auto max-w-6xl">
      <Breadcrumbs crumbs={crumbs} />
      <h1 class="mt-6 text-4xl font-semibold tracking-tight text-white md:text-6xl">
        Кто мы
      </h1>
      <span class="mt-4 inline-block h-1 w-12 bg-[#FFF200]"></span>
      <p class="mt-8 text-lg leading-relaxed text-white/75 md:text-xl">
        Крылья — команда организаторов мероприятий в&nbsp;Калининграде. Работаем
        с&nbsp;корпоративными и&nbsp;частными клиентами, а&nbsp;также с&nbsp;иногородними
        заказчиками.
        Организуем события под&nbsp;ключ — от&nbsp;концепции и&nbsp;брифа
        до&nbsp;команды на&nbsp;площадке в&nbsp;день мероприятия.
      </p>
      <p class="mt-6 text-base leading-relaxed text-white/65 md:text-lg">
        Как агентство работаем с&nbsp;2024 года — опираемся на&nbsp;годами
        наработанные компетенции и&nbsp;опыт в&nbsp;организации событий.
      </p>
    </div>
  </section>

  <div class="lab-divider-glow mx-auto max-w-6xl"></div>

  <!-- 3 опоры бренда -->
  <section class="relative px-6 py-14 md:px-12 md:py-20">
    <div class="mx-auto max-w-6xl">
      <h2 class="text-3xl font-semibold tracking-tight text-white md:text-5xl">
        Наши ценности
      </h2>
      <span class="mt-4 inline-block h-1 w-12 bg-[#FFF200]"></span>
      <div class="mt-12 grid gap-5 md:grid-cols-3">
        {pillars.map((p, i) => (
          <div class="rounded-2xl border border-white/10 bg-white/[0.03] p-6">
            <p class="mb-4 font-mono text-xs text-[#FFF200]">
              {String(i + 1).padStart(2, "0")}
            </p>
            <h3 class="text-xl font-semibold text-white">{p.title}</h3>
            <p class="mt-3 text-sm leading-relaxed text-white/65">{p.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <div class="lab-divider-glow mx-auto max-w-6xl"></div>

  <!-- Команда -->
  <section class="relative px-6 py-14 md:px-12 md:py-20">
    <div class="mx-auto max-w-6xl">
      <h2 class="text-3xl font-semibold tracking-tight text-white md:text-5xl">
        Команда
      </h2>
      <span class="mt-4 inline-block h-1 w-12 bg-[#FFF200]"></span>
      <div
        class="mt-12 grid gap-6 md:grid-cols-2"
        itemscope
        itemtype="https://schema.org/Organization"
      >
        <meta itemprop="name" content="Крылья" />
        {teamHighlights.map((m) => (
          <div
            class="rounded-2xl border border-white/10 bg-white/[0.02] p-6"
            itemprop="member"
            itemscope
            itemtype="https://schema.org/Person"
          >
            <div class="flex items-center gap-4">
              {m.photo ? (
                <img
                  src={m.photo}
                  alt={m.name}
                  width="96"
                  height="96"
                  loading="lazy"
                  class="h-24 w-24 shrink-0 rounded-xl object-cover object-[center_20%]"
                  itemprop="image"
                />
              ) : (
                <div class="flex h-24 w-24 shrink-0 items-center justify-center rounded-xl border border-white/10 bg-white/[0.04] text-[#FFF200]">
                  <svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" />
                    <circle cx="9" cy="7" r="4" />
                    <path d="M23 21v-2a4 4 0 0 0-3-3.87" />
                    <path d="M16 3.13a4 4 0 0 1 0 7.75" />
                  </svg>
                </div>
              )}
              <div>
                <h3 class="text-xl font-semibold text-white" itemprop="name">{m.name}</h3>
                <p class="mt-1 text-sm text-[#FFF200]" itemprop="jobTitle">{m.role}</p>
              </div>
            </div>
            <p
              class="mt-4 text-sm leading-relaxed text-white/65"
              itemprop="description"
            >
              {m.bio}
            </p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <div class="lab-divider-glow mx-auto max-w-6xl"></div>

  <!-- Как работаем — короткий блок -->
  <section class="relative px-6 py-14 md:px-12 md:py-20">
    <div class="mx-auto max-w-6xl">
      <h2 class="text-3xl font-semibold tracking-tight text-white md:text-5xl">
        Как мы работаем
      </h2>
      <span class="mt-4 inline-block h-1 w-12 bg-[#FFF200]"></span>
      <p class="mt-8 text-lg leading-relaxed text-white/75">
        После брифа мы&nbsp;готовим концепцию и&nbsp;прозрачную смету за&nbsp;3–5
        рабочих дней. Подрядчики идут в&nbsp;смете отдельной строкой по&nbsp;реальной
        цене. Это и&nbsp;есть «прозрачная 10%-модель»: вы&nbsp;точно понимаете,
        из&nbsp;чего складывается бюджет и&nbsp;за&nbsp;что платите.
      </p>
      <p class="mt-6 text-base leading-relaxed text-white/65 md:text-lg">
        В&nbsp;день мероприятия команда на&nbsp;площадке следит за&nbsp;таймингом
        и&nbsp;связью со&nbsp;всеми подрядчиками. От&nbsp;вас не&nbsp;требуется ничего, кроме
        присутствия в&nbsp;роли заказчика или гостя — мы&nbsp;берём операционку
        на&nbsp;себя.
      </p>
      <p class="mt-6 text-base leading-relaxed text-white/65 md:text-lg">
        Подробнее о&nbsp;подходе и&nbsp;услугах — на&nbsp;странице
        <a
          href="/services/"
          class="text-[#FFF200] underline decoration-[#FFF200]/40 underline-offset-4 hover:decoration-[#FFF200]"
        >направлений работы</a>
        и&nbsp;в&nbsp;<a
          href="/cases/"
          class="text-[#FFF200] underline decoration-[#FFF200]/40 underline-offset-4 hover:decoration-[#FFF200]"
        >наших кейсах</a>.
      </p>
    </div>
  </section>

  <div class="lab-divider-glow mx-auto max-w-6xl"></div>

  <ContactBlock />

  <MetrikaCounter slot="analytics" />
</DarkLayout>
