---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import Container from "../components/Container.astro";
import Section from "../components/Section.astro";
import Heading from "../components/Heading.astro";
import Button from "../components/Button.astro";

const services = await getCollection("services");
const cases = await getCollection("cases");
const testimonials = await getCollection("testimonials");
const team = await getCollection("team");
const teamSorted = [...team].sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout title="Test Design — Крылья" noindex>
  <Section>
    <Container>
      <p class="mb-4 inline-flex items-center gap-2 text-sm font-semibold uppercase tracking-wider text-gray-dark">
        <span class="inline-block h-2 w-8 bg-yellow"></span>
        Phase 2
      </p>
      <Heading level={1} accent>Дизайн-система</Heading>
      <p class="mt-6 max-w-2xl text-gray-dark leading-relaxed">
        Эта страница — техническая. Здесь мы проверяем, что цвета, шрифты, кнопки и контент-коллекции работают корректно. Не индексируется.
      </p>
    </Container>
  </Section>

  <Section class="bg-gray-light/20">
    <Container>
      <Heading level={2} accent>Фирменная палитра</Heading>
      <div class="mt-10 grid gap-4 grid-cols-2 sm:grid-cols-3 md:grid-cols-5">
        <div class="aspect-square bg-yellow flex items-end p-3 text-xs font-medium text-black">#FFF200<br />Жёлтый акцент</div>
        <div class="aspect-square bg-black flex items-end p-3 text-xs font-medium text-white">#000000<br />Чёрный</div>
        <div class="aspect-square bg-gray-dark flex items-end p-3 text-xs font-medium text-white">#414042<br />Тёмно-серый</div>
        <div class="aspect-square bg-gray-light flex items-end p-3 text-xs font-medium text-black">#BCBEC0<br />Светло-серый</div>
        <div class="aspect-square bg-white border border-gray-light flex items-end p-3 text-xs font-medium text-black">#FFFFFF<br />Белый</div>
      </div>
    </Container>
  </Section>

  <Section>
    <Container>
      <Heading level={2} accent>Типографика — Jost</Heading>
      <div class="mt-10 space-y-6">
        <Heading level={1}>Заголовок H1 — Bold 700</Heading>
        <Heading level={2}>Заголовок H2 — SemiBold 600</Heading>
        <Heading level={3}>Заголовок H3 — SemiBold 600</Heading>
        <Heading level={4}>Заголовок H4 — Medium 500</Heading>
        <p class="max-w-2xl text-base leading-relaxed">
          Параграф — обычный текст в Jost Regular 400. Тут идёт длинная фраза, чтобы оценить читаемость, межстрочный интервал и общее ощущение от шрифта на абзаце среднего размера. Кириллица должна выглядеть аккуратно и геометрично.
        </p>
        <p class="max-w-2xl text-sm text-gray-light">
          Мелкий служебный текст в светло-сером — для подписей, мета-информации, дисклеймеров.
        </p>
      </div>
    </Container>
  </Section>

  <Section class="bg-gray-light/20">
    <Container>
      <Heading level={2} accent>Кнопки</Heading>
      <div class="mt-10 flex flex-wrap gap-4">
        <Button variant="primary">Оставить заявку</Button>
        <Button variant="secondary">Позвонить</Button>
        <Button href="/" variant="primary">Кнопка-ссылка</Button>
        <Button href="/test-design/" variant="secondary">Вторичная ссылка</Button>
      </div>
      <p class="mt-4 text-sm text-gray-dark">Наведи курсор — primary меняется на жёлтый, secondary на чёрный.</p>
    </Container>
  </Section>

  <Section>
    <Container>
      <Heading level={2} accent>Контент-коллекции</Heading>
      <p class="mt-4 text-gray-dark">Тестовые записи в каждой коллекции, схемы Zod-валидации работают.</p>

      <div class="mt-10 grid gap-12 md:grid-cols-2">
        <div>
          <Heading level={3}>Услуги ({services.length})</Heading>
          <ul class="mt-4 space-y-3">
            {services.map((s) => (
              <li class="border-l-4 border-yellow pl-4">
                <strong class="block text-black">{s.data.title}</strong>
                <span class="text-sm text-gray-dark">{s.data.description}</span>
              </li>
            ))}
          </ul>
        </div>

        <div>
          <Heading level={3}>Кейсы ({cases.length})</Heading>
          <ul class="mt-4 space-y-3">
            {cases.map((c) => (
              <li class="border-l-4 border-yellow pl-4">
                <strong class="block text-black">{c.data.title}</strong>
                <span class="text-sm text-gray-dark">Клиент: {c.data.client} · {new Date(c.data.date).getFullYear()}</span>
              </li>
            ))}
          </ul>
        </div>

        <div>
          <Heading level={3}>Отзывы ({testimonials.length})</Heading>
          <ul class="mt-4 space-y-3">
            {testimonials.map((t) => (
              <li class="border-l-4 border-yellow pl-4">
                <em class="block text-gray-dark">«{t.data.quote}»</em>
                <span class="text-sm text-black mt-1 block">— {t.data.author}, {t.data.role}{t.data.company ? `, ${t.data.company}` : ""}</span>
              </li>
            ))}
          </ul>
        </div>

        <div>
          <Heading level={3}>Команда ({team.length})</Heading>
          <ul class="mt-4 space-y-4">
            {teamSorted.map((m) => (
              <li class="border-l-4 border-yellow pl-4">
                <strong class="block text-black">{m.data.name}</strong>
                <span class="text-sm text-gray-dark italic">{m.data.role}</span>
                <p class="text-sm text-gray-dark mt-1">{m.data.bio}</p>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </Container>
  </Section>
</BaseLayout>
