---
/*
 * /cases/ — витрина кейсов в тёмной палитре (Phase 5.1 wave 4).
 *
 * Сетка карточек по дате (desc), аспект 4:5, фото с затемнением + клиент
 * + название + первый chip факта поверх. Курсор «крылья» (lab-cursor-wings).
 */
import { getCollection } from "astro:content";
import DarkLayout from "../../layouts/DarkLayout.astro";
import Seo from "../../components/Seo.astro";
import JsonLdGraph from "../../components/JsonLdGraph.astro";
import MetrikaCounter from "../../components/MetrikaCounter.astro";
import ContactBlock from "../../components/blocks/ContactBlock.astro";

const all = await getCollection("cases");
const cases = all.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const seoTitle = "Кейсы — мероприятия в Калининграде, организованные Крыльями";
const seoDescription =
  "Подборка проектов агентства Крылья: партнёрский вечер ЖК, открытие, новогодний корпоратив девелопера, фестиваль современного искусства, частный юбилей. Калининград и область.";
---

<DarkLayout title={seoTitle} description={seoDescription}>
  <Seo
    slot="seo"
    title={seoTitle}
    description={seoDescription}
    pathname="/cases/"
  />
  <JsonLdGraph slot="seo" />

  <!-- Hero страницы витрины -->
  <section class="relative px-6 pt-32 pb-10 md:px-12 md:pt-40 md:pb-16">
    <div class="mx-auto max-w-6xl">
      <nav aria-label="Хлебные крошки" class="mb-8 text-sm text-white/55">
        <ol class="flex flex-wrap items-center gap-2">
          <li>
            <a href="/" class="text-white/55 no-underline transition-colors hover:text-white">Главная</a>
          </li>
          <li class="text-white/30">·</li>
          <li class="text-white">Кейсы</li>
        </ol>
      </nav>

      <h1 class="text-4xl font-semibold leading-tight tracking-tight text-white md:text-6xl">
        Кейсы
      </h1>
      <span class="mt-4 inline-block h-1 w-12 bg-[#FFF200]"></span>
      <p class="mt-6 max-w-2xl text-base leading-relaxed text-white/65 md:text-lg">
        Каждое мероприятие&nbsp;— своя задача и&nbsp;свой характер. Проекты,
        которые реализовала наша команда,&nbsp;— с&nbsp;историей и&nbsp;кадрами
        с&nbsp;площадок.
      </p>
    </div>
  </section>

  <!-- Сетка кейсов -->
  <section class="relative px-6 pb-20 md:px-12 md:pb-28">
    <div class="mx-auto max-w-6xl">
      {cases.length > 0 ? (
        <div class="grid gap-x-5 gap-y-8 sm:grid-cols-2 lg:grid-cols-3">
          {cases.map((c) => {
            const firstFact = c.data.heroFact || c.data.format || c.data.guests;
            return (
              <a
                href={`/cases/${c.data.slug}/`}
                class="lab-cursor-wings group block no-underline"
              >
                <div class="relative aspect-[4/3] overflow-hidden rounded-xl">
                  <img
                    src={`/assets/cases/${c.data.slug}/${c.data.cover}`}
                    alt={`Обложка: ${c.data.title}`}
                    class="absolute inset-0 h-full w-full object-cover transition-transform duration-700 ease-out group-hover:scale-105"
                    loading="lazy"
                  />
                </div>
                <p class="mt-4 text-[10px] font-semibold uppercase tracking-[0.2em] text-[#FFF200]">
                  {c.data.client}
                </p>
                <h2 class="mt-1.5 text-base font-semibold leading-tight tracking-tight text-white md:text-lg">
                  {c.data.title}
                </h2>
                {firstFact && firstFact !== "TODO" && (
                  <p class="mt-1.5 text-sm text-white/55">{firstFact}</p>
                )}
              </a>
            );
          })}
        </div>
      ) : (
        <p class="text-white/60 italic">Кейсы появятся скоро.</p>
      )}
    </div>
  </section>

  <div class="lab-divider-glow mx-auto max-w-6xl"></div>

  <ContactBlock />

  <MetrikaCounter slot="analytics" />
</DarkLayout>
