---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Container from "../../components/Container.astro";
import Section from "../../components/Section.astro";
import Heading from "../../components/Heading.astro";
import Seo from "../../components/Seo.astro";
import JsonLdGraph from "../../components/JsonLdGraph.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import MetrikaCounter from "../../components/MetrikaCounter.astro";
import ContactBlock from "../../components/blocks/ContactBlock.astro";

const all = await getCollection("cases");
const cases = all.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const seoTitle = "Кейсы — мероприятия в Калининграде, организованные Крыльями";
const seoDescription =
  "Подборка проектов агентства Крылья: партнёрский вечер ЖК, открытие, новогодний корпоратив девелопера, фестиваль современного искусства, частный юбилей. Калининград и область.";

const crumbs = [
  { label: "Главная", href: "/" },
  { label: "Кейсы", href: "/cases/" },
];
---

<BaseLayout title={seoTitle} description={seoDescription} noindex>
  <Seo
    slot="seo"
    title={seoTitle}
    description={seoDescription}
    pathname="/cases/"
  />
  <JsonLdGraph slot="seo" />

  <Section class="border-b border-gray-light bg-white pb-8 md:pb-12">
    <Container>
      <Breadcrumbs crumbs={crumbs} />
    </Container>
  </Section>

  <Section>
    <Container>
      <Heading level={1} accent>Наши кейсы</Heading>
      <p class="mt-6 max-w-3xl text-lg text-gray-dark leading-relaxed">
        Несколько проектов в&nbsp;Калининграде и&nbsp;области — формат, задача и&nbsp;что
        сделали. По&nbsp;каждой ссылке — детальный разбор и&nbsp;фото с&nbsp;площадки.
      </p>

      {cases.length > 0 ? (
        <div class="mt-12 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
          {cases.map((c) => (
            <a
              href={`/cases/${c.data.slug}/`}
              class="group block overflow-hidden bg-white border border-gray-light hover:border-yellow hover:shadow-lg transition-all"
            >
              <div class="aspect-[4/3] overflow-hidden bg-gray-light/30">
                <img
                  src={`/assets/cases/${c.data.slug}/${c.data.cover}`}
                  alt={`Обложка: ${c.data.title}`}
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                  loading="lazy"
                />
              </div>
              <div class="p-6 md:p-8">
                <span class="text-xs font-semibold uppercase tracking-wider text-yellow">
                  {c.data.client}
                </span>
                <h2 class="mt-2 text-xl font-semibold text-black">{c.data.title}</h2>
                <p class="mt-3 text-sm text-gray-dark flex items-center gap-2">
                  <span class="inline-block h-1.5 w-1.5 bg-yellow rounded-full"></span>
                  {c.data.heroFact}
                </p>
                <span class="mt-6 inline-flex items-center gap-2 text-sm font-medium text-black">
                  Читать кейс
                  <span class="inline-block h-0.5 w-6 bg-yellow group-hover:w-10 transition-all"></span>
                </span>
              </div>
            </a>
          ))}
        </div>
      ) : (
        <p class="mt-12 text-gray-dark italic">Кейсы появятся в Phase 5.</p>
      )}
    </Container>
  </Section>

  <ContactBlock />

  <MetrikaCounter slot="analytics" />
</BaseLayout>
