---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Container from "../../components/Container.astro";
import Section from "../../components/Section.astro";
import Heading from "../../components/Heading.astro";
import Seo from "../../components/Seo.astro";
import JsonLdGraph from "../../components/JsonLdGraph.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import MetrikaCounter from "../../components/MetrikaCounter.astro";
import ContactBlock from "../../components/blocks/ContactBlock.astro";

const all = await getCollection("cases");
const cases = all.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const seoTitle = "Кейсы — мероприятия в Калининграде, организованные Крыльями";
const seoDescription =
  "Подборка проектов агентства Крылья: партнёрский вечер ЖК, открытие, новогодний корпоратив девелопера, фестиваль современного искусства, частный юбилей. Калининград и область.";

const crumbs = [
  { label: "Главная", href: "/" },
  { label: "Кейсы", href: "/cases/" },
];
---

<BaseLayout title={seoTitle} description={seoDescription} noindex>
  <Seo
    slot="seo"
    title={seoTitle}
    description={seoDescription}
    pathname="/cases/"
  />
  <JsonLdGraph slot="seo" />

  <Section class="border-b border-gray-light bg-white !py-4 md:!py-6">
    <Container>
      <Breadcrumbs crumbs={crumbs} />
    </Container>
  </Section>

  <Section class="!pt-8 md:!pt-12">
    <Container>
      <Heading level={1} accent>Наши кейсы</Heading>
      <p class="mt-6 max-w-3xl text-lg text-gray-dark leading-relaxed">
        Каждое мероприятие — своя задача и&nbsp;свой характер. Проекты, которые
        реализовала наша команда, с&nbsp;разбором решений и&nbsp;кадрами с&nbsp;площадок.
      </p>

      {cases.length > 0 ? (
        <div class="mt-12 grid gap-1 md:grid-cols-2 lg:grid-cols-3">
          {cases.map((c) => (
            <a
              href={`/cases/${c.data.slug}/`}
              class="group relative block overflow-hidden bg-black aspect-[4/3]"
            >
              <img
                src={`/assets/cases/${c.data.slug}/${c.data.cover}`}
                alt={`Обложка: ${c.data.title}`}
                class="absolute inset-0 w-full h-full object-cover opacity-90 group-hover:opacity-100 group-hover:scale-105 transition-all duration-500"
                loading="lazy"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/30 to-transparent"></div>
              <div class="absolute inset-x-0 bottom-0 p-6 md:p-8">
                <span class="text-xs font-semibold uppercase tracking-wider text-yellow">
                  {c.data.client}
                </span>
                <h2 class="mt-2 text-xl md:text-2xl font-semibold text-white leading-tight">
                  {c.data.title}
                </h2>
              </div>
            </a>
          ))}
        </div>
      ) : (
        <p class="mt-12 text-gray-dark italic">Кейсы появятся в Phase 5.</p>
      )}
    </Container>
  </Section>

  <ContactBlock />

  <MetrikaCounter slot="analytics" />
</BaseLayout>
