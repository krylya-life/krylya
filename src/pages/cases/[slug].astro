---
/*
 * /cases/[slug]/ — страница кейса в тёмной палитре (Phase 5.1 wave 4).
 *
 * Структура:
 *  1. CaseHero — большая обложка с заголовком, клиент-лейблом, чипами фактов
 *  2. Breadcrumbs над контентом
 *  3. Текст «Задача → Решение → Итог» из markdown
 *  4. CaseGallery — сетка фото (если photos.length > 0)
 *  5. CTA «Обсудить мероприятие»
 *  6. NextCaseCard — следующий кейс (циклически)
 *
 * SEO: JsonLdGraph + JsonLdEvent (Event-schema), BreadcrumbList в Breadcrumbs.
 */
import { getCollection, render } from "astro:content";
import DarkLayout from "../../layouts/DarkLayout.astro";
import Seo from "../../components/Seo.astro";
import JsonLdGraph from "../../components/JsonLdGraph.astro";
import JsonLdEvent from "../../components/JsonLdEvent.astro";
import MetrikaCounter from "../../components/MetrikaCounter.astro";
import CaseHero from "../../components/blocks/CaseHero.astro";
import CaseGallery from "../../components/blocks/CaseGallery.astro";
import NextCaseCard from "../../components/blocks/NextCaseCard.astro";
import { business } from "../../config/business.ts";

export async function getStaticPaths() {
  const all = await getCollection("cases");
  const sorted = all.sort(
    (a, b) => b.data.date.getTime() - a.data.date.getTime()
  );
  return sorted.map((c, i) => {
    const next = sorted[(i + 1) % sorted.length];
    return {
      params: { slug: c.id },
      props: { current: c, next },
    };
  });
}

const { current, next } = Astro.props;
const { Content } = await render(current);
const d = current.data;

const coverPath = `/assets/cases/${d.slug}/${d.cover}`;
const coverAbsolute = `${business.url}${coverPath}`;

const dateFormatted = new Intl.DateTimeFormat("ru-RU", {
  month: "long",
  year: "numeric",
}).format(d.date);

// Чипы фактов — собираем из полей frontmatter, фильтруем TODO/пустоту
const rawChips = [d.format, d.guests, d.duration, d.venue, dateFormatted];
const chips = rawChips
  .filter((v): v is string => Boolean(v))
  .filter((v) => v !== "TODO" && !v.startsWith("TODO"));

const seoTitle = `${d.title} — кейс агентства Крылья (${d.client}, Калининград)`;
const seoDescription =
  d.challenge.length > 160 ? d.challenge.slice(0, 157) + "..." : d.challenge;
---

<DarkLayout title={seoTitle} description={seoDescription}>
  <Seo
    slot="seo"
    title={seoTitle}
    description={seoDescription}
    pathname={`/cases/${d.slug}/`}
    image={coverAbsolute}
  />
  <JsonLdGraph slot="seo" />
  <JsonLdEvent
    slot="seo"
    slug={d.slug}
    name={d.title}
    description={d.challenge}
    startDate={d.date}
    client={d.client}
    venue={d.venue}
    imageUrl={coverAbsolute}
  />

  <CaseHero
    title={d.title}
    client={d.eyebrow || d.client}
    slug={d.slug}
    cover={d.cover}
    chips={chips}
  />

  {d.wip ? (
    <!-- Заглушка: кейс в разработке -->
    <section class="relative px-6 pt-10 pb-16 md:px-12 md:pt-14 md:pb-24">
      <div class="mx-auto max-w-2xl text-center">
        <span class="inline-flex items-center rounded-full border border-white/15 bg-white/[0.05] px-4 py-1.5 text-xs font-medium uppercase tracking-[0.2em] text-white/70">
          В&nbsp;разработке
        </span>
        <h2 class="mt-6 text-2xl font-semibold tracking-tight text-white md:text-3xl">
          Кейс готовится
        </h2>
        <p class="mt-4 text-base leading-relaxed text-white/60 md:text-lg">
          Скоро здесь появятся фотографии с&nbsp;площадки и&nbsp;подробное описание проекта. А&nbsp;пока загляните в&nbsp;другие наши кейсы.
        </p>
        <a
          href="/cases/"
          class="mt-8 inline-flex items-center justify-center rounded-full border border-white/15 bg-white/[0.03] px-6 py-3 text-sm font-medium text-white/85 no-underline transition hover:border-white/30 hover:text-white"
        >
          Все кейсы
        </a>
      </div>
    </section>
  ) : (
    <!-- Контент: текст слева, фото справа (на десктопе); на мобиле — друг под другом -->
    <section class="relative px-6 pt-6 pb-14 md:px-12 md:pt-10 md:pb-20">
      <div class="mx-auto max-w-6xl">
        <div class="grid gap-10 lg:grid-cols-2 lg:gap-14">
          <article
            class="text-white/80
              [&_h2]:mt-12 [&_h2:first-child]:mt-0 [&_h2]:text-2xl [&_h2]:font-semibold [&_h2]:tracking-tight [&_h2]:text-white md:[&_h2]:text-3xl
              [&_h3]:mt-8 [&_h3]:text-xl [&_h3]:font-semibold [&_h3]:text-white
              [&_p]:mt-5 [&_p]:leading-relaxed md:[&_p]:text-lg
              [&_strong]:text-white
              [&_ul]:mt-5 [&_ul]:list-disc [&_ul]:pl-6 [&_ul]:space-y-2
              [&_li]:leading-relaxed
              [&_a]:text-[#FFF200] [&_a]:underline [&_a]:underline-offset-4"
          >
            <Content />
          </article>

          {d.photos && d.photos.length > 0 && (
            <div>
              <h2 class="text-2xl font-semibold tracking-tight text-white md:text-3xl">
                Фото с&nbsp;площадки
              </h2>
              <span class="mb-6 mt-4 inline-block h-1 w-12 bg-[#FFF200]"></span>
              <CaseGallery photos={d.photos} slug={d.slug} title={d.title} />
            </div>
          )}
        </div>
      </div>
    </section>
  )}

  <div class="lab-divider-glow mx-auto max-w-6xl"></div>

  <!-- CTA «Обсудить мероприятие» -->
  <section class="relative px-6 py-14 md:px-12 md:py-20">
    <div class="mx-auto max-w-3xl text-center">
      <h2 class="text-2xl font-semibold tracking-tight text-white md:text-4xl">
        Хотите такое&nbsp;же&nbsp;— или совсем другое?
      </h2>
      <p class="mt-6 text-base leading-relaxed text-white/65 md:text-lg">
        Расскажите о&nbsp;вашем мероприятии&nbsp;— обсудим формат, площадку
        и&nbsp;ориентировочную смету.
      </p>
      <a
        href="/contacts/"
        class="mt-8 inline-flex items-center justify-center rounded-full bg-[#FFF200] px-7 py-3.5 text-sm font-semibold text-black no-underline transition-colors hover:bg-[#FFF566]"
      >
        Обсудить мероприятие
      </a>
    </div>
  </section>

  <NextCaseCard
    next={{
      title: next.data.title,
      slug: next.data.slug,
      client: next.data.eyebrow || next.data.client,
      cover: next.data.cover,
    }}
  />

  <MetrikaCounter slot="analytics" />
</DarkLayout>
