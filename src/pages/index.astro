---
import BaseLayout from "../layouts/BaseLayout.astro";
import Container from "../components/Container.astro";
import Section from "../components/Section.astro";
import Heading from "../components/Heading.astro";
import Button from "../components/Button.astro";
---

<BaseLayout
  title="Крылья — ивент-агентство в Калининграде"
  description="Организация мероприятий под ключ в Калининграде. Корпоративные праздники, деловые события, кейсы. Работаем с 2024 года."
  noindex
>
  <Section>
    <Container>
      <Heading level={1}>
        Сайт <span class="bg-yellow px-2">в разработке</span>
      </Heading>
      <p class="mt-6 max-w-2xl text-lg text-gray-dark">
        Идёт переезд агентства «Крылья» с Tilda на новый стек. Запуск ожидается к 15 мая 2026. Если хотите обсудить мероприятие уже сейчас — свяжитесь напрямую:
      </p>
      <div class="mt-8 flex flex-wrap gap-4">
        <Button href="tel:+79118627957" variant="primary">+7 911 862 7957</Button>
        <Button href="mailto:wings.agency@yandex.ru" variant="secondary">wings.agency@yandex.ru</Button>
      </div>
    </Container>
  </Section>
</BaseLayout>
