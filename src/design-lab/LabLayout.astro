---
import "./styles/lab.css";

interface Props {
  title: string;
  description?: string;
}
const {
  title,
  description = "Дизайн-песочница Крыльев — эксперимент с тёмной темой и эффектами Aceternity / Magic UI",
} = Astro.props;
---

<!doctype html>
<html lang="ru" class="lab-root">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title}</title>
    <link rel="icon" type="image/png" href="/brand/wings-sign.png" />

    {/* Preload бренд-шрифта Jost (cyrillic, weights 400/700) — самые ходовые начертания.
        Остальные веса (500/600, латиница) подгружаются лениво через @font-face в lab.css. */}
    <link
      rel="preload"
      href="/fonts/jost-cyrillic-400.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/jost-cyrillic-700.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
  </head>
  <body class="lab-root min-h-screen">
    <slot />
    <script>
      // Жёлтое свечение за курсором на .lab-magic-card.
      // Вариант без React — работает во всех браузерах, в т.ч. Safari.
      document.addEventListener("pointermove", (e) => {
        const card = e.target instanceof Element
          ? e.target.closest(".lab-magic-card")
          : null;
        if (!(card instanceof HTMLElement)) return;
        const rect = card.getBoundingClientRect();
        card.style.setProperty("--mx", `${e.clientX - rect.left}px`);
        card.style.setProperty("--my", `${e.clientY - rect.top}px`);
      });
    </script>
  </body>
</html>
