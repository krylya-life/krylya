---
import "./styles/lab.css";

interface Props {
  title: string;
  description?: string;
}
const {
  title,
  description = "Дизайн-песочница Крыльев — эксперимент с тёмной темой и эффектами Aceternity / Magic UI",
} = Astro.props;
---

<!doctype html>
<html lang="ru" class="lab-root">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title}</title>
    <link rel="icon" type="image/png" href="/brand/wings-sign.png" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap"
    />
  </head>
  <body class="lab-root min-h-screen">
    <slot />
    <script>
      // Жёлтое свечение за курсором на .lab-magic-card.
      // Вариант без React — работает во всех браузерах, в т.ч. Safari.
      document.addEventListener("pointermove", (e) => {
        const card = e.target instanceof Element
          ? e.target.closest(".lab-magic-card")
          : null;
        if (!(card instanceof HTMLElement)) return;
        const rect = card.getBoundingClientRect();
        card.style.setProperty("--mx", `${e.clientX - rect.left}px`);
        card.style.setProperty("--my", `${e.clientY - rect.top}px`);
      });
    </script>
  </body>
</html>
