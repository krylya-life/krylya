---
/*
 * Силуэт Калининграда — тонкая линейная графика жёлтым.
 * Слева направо: Бранденбургские ворота, Храм Христа Спасителя,
 * Кафедральный собор Канта (главный акцент), башня Рыбной деревни
 * с маяком, Дом Советов.
 */
---

<svg
  class="kaliningrad-silhouette pointer-events-none absolute bottom-12 left-[-6%] w-[112%] opacity-[0.32]"
  viewBox="0 0 1600 360"
  preserveAspectRatio="xMidYMax slice"
  fill="none"
  stroke="#FFF200"
  stroke-width="1.2"
  stroke-linejoin="round"
  stroke-linecap="round"
  aria-hidden="true"
>
  <defs>
    <linearGradient id="kgd-line-fade" x1="0" y1="0" x2="1" y2="0">
      <stop offset="0%" stop-color="#FFF200" stop-opacity="0" />
      <stop offset="12%" stop-color="#FFF200" stop-opacity="0.55" />
      <stop offset="50%" stop-color="#FFF200" stop-opacity="0.9" />
      <stop offset="88%" stop-color="#FFF200" stop-opacity="0.55" />
      <stop offset="100%" stop-color="#FFF200" stop-opacity="0" />
    </linearGradient>
  </defs>

  <g stroke="url(#kgd-line-fade)">
    {/* === Дальние крыши слева === */}
    <path d="M 0 308 L 60 308 L 75 290 L 110 290 L 125 308 L 175 308 L 175 282 L 210 282 L 220 270 L 240 270 L 250 282 L 250 308 L 270 308" opacity="0.55" />

    {/* === 1. Бранденбургские ворота === */}
    <path d="
      M 270 308
      L 270 250
      L 282 250 L 282 236 L 290 236 L 290 220 L 296 220 L 296 200 L 306 178 L 316 200 L 316 220 L 322 220 L 322 236 L 330 236 L 330 250 L 340 250
      L 340 250 L 340 230 L 358 230 L 360 224 L 380 224 L 382 230 L 400 230 L 400 250
      L 410 250 L 410 236 L 418 236 L 418 220 L 424 220 L 424 200 L 434 178 L 444 200 L 444 220 L 450 220 L 450 236 L 458 236 L 458 250 L 470 250
      L 470 308
    " />
    {/* Маленькие флаги на остриях */}
    <line x1="306" y1="178" x2="306" y2="164" />
    <path d="M 306 164 L 314 167 L 306 170" />
    <line x1="434" y1="178" x2="434" y2="164" />
    <path d="M 434 164 L 442 167 L 434 170" />

    {/* === Узкие фасады между воротами и храмом === */}
    <path d="M 480 308 L 480 282 L 510 282 L 510 308" opacity="0.7" />
    <path d="M 520 308 L 520 274 L 530 264 L 540 274 L 540 308" opacity="0.7" />

    {/* === 2. Храм Христа Спасителя === */}
    <path d="M 560 308 L 560 242 L 690 242 L 690 308" />
    {/* Малые луковки слева (2) */}
    <path d="M 572 242 Q 572 226 580 220 Q 588 226 588 242" />
    <line x1="580" y1="220" x2="580" y2="208" />
    <path d="M 596 242 Q 596 224 604 218 Q 612 224 612 242" />
    <line x1="604" y1="218" x2="604" y2="204" />
    {/* Центральный барабан с большим куполом */}
    <rect x="618" y="218" width="14" height="24" />
    <rect x="618" y="218" width="14" height="24" transform="translate(20 0)" />
    <path d="M 614 218 L 656 218" />
    <path d="M 612 218 Q 612 184 635 174 Q 658 184 658 218" />
    {/* Крест */}
    <line x1="635" y1="174" x2="635" y2="156" stroke-width="1.4" />
    <line x1="628" y1="162" x2="642" y2="162" stroke-width="1.4" />
    {/* Малые луковки справа (2) */}
    <path d="M 660 242 Q 660 224 668 218 Q 676 224 676 242" />
    <line x1="668" y1="218" x2="668" y2="204" />
    <path d="M 680 242 Q 680 226 688 220 Q 696 226 696 242" />
    <line x1="688" y1="220" x2="688" y2="208" />

    {/* === Дальние крыши === */}
    <path d="M 710 308 L 710 282 L 738 282 L 738 308" opacity="0.6" />

    {/* === 3. Кафедральный собор Канта — главная вертикаль === */}
    {/* Левое крыло */}
    <path d="
      M 750 308
      L 750 232
      L 758 232 L 758 222 L 766 222 L 766 232
      L 774 232 L 774 220 L 782 220 L 782 232
      L 790 232 L 790 222 L 798 222 L 798 232
      L 806 232
    " />
    {/* Центральная башня со шпилем */}
    <path d="
      M 806 232
      L 806 210 L 810 210 L 810 192 L 814 192 L 814 174 L 818 174 L 818 152 L 822 152 L 822 122 L 826 92
      L 830 122 L 834 122 L 834 152 L 838 152 L 838 174 L 842 174 L 842 192 L 846 192 L 846 210 L 850 210
      L 850 232
    " />
    {/* Крест на шпиле */}
    <line x1="826" y1="92" x2="826" y2="68" stroke-width="1.6" />
    <line x1="818" y1="78" x2="834" y2="78" stroke-width="1.6" />
    {/* Окно-роза на башне */}
    <circle cx="828" cy="200" r="5" />
    {/* Правое крыло */}
    <path d="
      M 850 232
      L 858 232 L 858 222 L 866 222 L 866 232
      L 874 232 L 874 220 L 882 220 L 882 232
      L 890 232 L 890 222 L 898 222 L 898 232
      L 906 232
      L 906 308
    " opacity="0.95" />
    {/* Основание собора */}
    <line x1="750" y1="308" x2="906" y2="308" opacity="0" />

    {/* === Прибрежные домики Рыбной деревни === */}
    <path d="M 925 308 L 925 280 L 935 268 L 945 280 L 945 308 M 935 268 L 935 290 M 920 280 L 950 280" opacity="0.8" />
    <path d="M 950 308 L 950 282 L 960 270 L 970 282 L 970 308" opacity="0.8" />
    <path d="M 972 308 L 972 278 L 982 266 L 992 278 L 992 308" opacity="0.8" />

    {/* === 4. Башня Рыбной деревни ("Маяк Высокий") === */}
    <path d="
      M 1010 308
      L 1010 244
      L 1016 238 L 1016 224 L 1022 218 L 1022 204
      L 1018 200
      L 1018 188 L 1042 188 L 1042 200
      L 1038 204 L 1038 218 L 1044 224 L 1044 238 L 1050 244
      L 1050 308
    " />
    {/* Шпиль маяка */}
    <path d="M 1018 188 L 1030 168 L 1042 188" />
    {/* Жёлтая лампа маяка */}
    <circle cx="1030" cy="195" r="2.5" fill="#FFF200" stroke="none" />
    {/* Кольцо вокруг лампы (свет) */}
    <circle cx="1030" cy="195" r="6" opacity="0.4" />

    {/* === Жилые крыши === */}
    <path d="M 1075 308 L 1075 278 L 1105 278 L 1105 308" opacity="0.7" />
    <path d="M 1112 308 L 1112 266 L 1132 266 L 1132 308" opacity="0.7" />
    <path d="M 1140 308 L 1140 272 L 1150 262 L 1160 272 L 1160 308" opacity="0.7" />

    {/* === 5. Дом Советов === */}
    {/* Постамент */}
    <rect x="1190" y="278" width="120" height="30" />
    {/* Основной куб */}
    <rect x="1200" y="218" width="100" height="60" />
    {/* Верхняя ступень-голова */}
    <rect x="1208" y="200" width="84" height="18" />
    {/* Антенна */}
    <rect x="1240" y="186" width="20" height="14" />
    <line x1="1250" y1="186" x2="1250" y2="166" />
    {/* Окна-глаза */}
    <line x1="1215" y1="232" x2="1247" y2="232" />
    <line x1="1253" y1="232" x2="1285" y2="232" />
    <line x1="1215" y1="246" x2="1247" y2="246" />
    <line x1="1253" y1="246" x2="1285" y2="246" />
    {/* Окно-рот */}
    <line x1="1220" y1="262" x2="1280" y2="262" />

    {/* === Дальние крыши справа === */}
    <path d="M 1330 308 L 1330 282 L 1360 282 L 1370 270 L 1395 270 L 1405 282 L 1430 282 L 1430 308" opacity="0.55" />
    <path d="M 1450 308 L 1450 270 L 1465 258 L 1480 270 L 1480 308" opacity="0.55" />
    <path d="M 1500 308 L 1500 280 L 1545 280 L 1545 308" opacity="0.55" />
    <path d="M 1560 308 L 1560 286 L 1580 286 L 1590 274 L 1600 274 L 1600 308" opacity="0.55" />
  </g>

  {/* Тонкий "горизонт" — линия земли */}
  <line x1="0" y1="308" x2="1600" y2="308" stroke="url(#kgd-line-fade)" stroke-width="1" opacity="0.6" />
</svg>
