# Шаблон переменных окружения. Реальные значения — в Netlify Environment Variables, НЕ в git.
#
# Скопируй файл в .env (для локальной разработки), заполни значения, и НИ В КОЕМ СЛУЧАЕ
# не коммить .env в репозиторий — он в .gitignore.

# Telegram Bot API — для отправки уведомлений о заявках с формы
# Получить через @BotFather (Phase 1)
TELEGRAM_BOT_TOKEN=

# Telegram chat_id Марии — куда бот шлёт уведомления
# Получить через @userinfobot (Phase 0, уже зафиксировано: 129375931)
TELEGRAM_CHAT_ID=
